url = "https://www.tandfonline.com/doi/abs/10.1207/s15324834basp2604_4",
file = "All_Papers/Published_Journal/J_TF1505/Struthers2004_11690.pdf",
keywords = "J\_TF1505;Basic Appl Soc Psych",
