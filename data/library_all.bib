keywords = "Behavioral economics; Cognitive load; Dual-self theory; Food choice; Fruit and vegetable selection; Grocery shopping; Health concerns; Product bundling;316\_介入実験\_環境手がかり",
doi = "10.1016/j.appet.2017.11.082",
language = "en"
}

