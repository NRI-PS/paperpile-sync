@ARTICLE{Payne2022-COVID-19AndSocialDistancingMeasuresInQueenslandAustraliaAreAssociatedWithShort-termDecreasesInRecordedViolentCrime-..-yb,
title = "COVID-19 and social distancing measures in Queensland, Australia, are associated with short-term decreases in recorded violent crime",
author = "Payne, Jason L and Morgan, Anthony and Piquero, Alex R",
journal = "Journal of experimental criminology",
