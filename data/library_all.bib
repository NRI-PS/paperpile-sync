@ARTICLE{Storey2014-AssessmentAndManagementOfRiskForIntimatePartnerViolenceByPoliceOfficersUsingTheBriefSpousalAssaultFormForTheEvaluationOfRisk-..-sx,
title = "Assessment and management of risk for intimate partner violence by police officers using the Brief Spousal Assault Form for the Evaluation of risk",
