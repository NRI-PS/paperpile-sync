@ARTICLE{MacDonald2013-ThePrivatizationOfPublicSafetyInUrbanNeighborhoodsDoBusinessImprovementDistrictsReduceViolentCrimeAmongAdolescentsThePrivatizationOfPublicSafetyInUrbanNeighborhoods-..-oz,
title = "The privatization of public safety in urban neighborhoods: Do business improvement districts reduce violent crime among adolescents?: The privatization of public safety in urban neighborhoods",
