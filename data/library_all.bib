number =  3,
pages = "249-258",
abstract = "U.S. citizens' reactions to the terrorist attacks of September 11, 2001, were examined, including emotional responses, attributions for the cause of the attacks, and policy recommendations. Participants whose emotional reactions were dominated by anger attributed the attacks to the fanaticism of the terrorists and to poor U.S. security and rejected the idea that U.S. foreign policy played a role in the attacks. They endorsed an aggressive military response and rejected humanitarian efforts. Participants whose emotional reactions were dominated by sadness, in contrast, denied that fanaticism and security lapses were to blame, and both sad and fearful participants expressed reservations about a strong military reaction. Path models suggest that the relationship between emotional reactions and policy endorsement was partially mediated by attributions.",
month =  sep,
year =  2005,
url = "https://www.tandfonline.com/doi/abs/10.1207/s15324834basp2703_6",
file = "All_Papers/Published_Journal/J_TF1505/Sadler2005_06821.pdf",
keywords = "SOCIAL psychology; EMOTIONS; Attribution; AFFECT (Psychology); TERRORISM; SEPTEMBER 11 Terrorist Attacks, 2001; PSYCHOLOGICAL aspects;J\_TF1505;Basic Appl Soc Psych",
doi = "10.1207/s15324834basp2703\_6",
language = "en"
}

@ARTICLE{Sacco2003-BlackHandOutrageAConstructionistAnalysisOfAnUrbanCrimeWave-..-eg,
title = "Black hand outrage: A constructionist analysis of an urban crime wave",
author = "Sacco, Vincent F",
journal = "Deviant behavior",
publisher = "Informa UK Limited",
volume =  24,
number =  1,
pages = "53-77",
abstract = "The existing literature on the sociology of crime waves has tended to focus attention on either the objective or subjective character of these phenomena. In the former sense, it is argued that crime waves occur when there are objectively measurable shifts in the frequency or seriousness of crime. By contrast, subjective interpretations emphasize the extent to which crime waves are rooted in the perceptions of journalists, police, and members of the general public. Using insights derived from contextual constructionist approaches to social problems, the present paper attempts toargue that these views on the origin and development of crime waves are complementary rather than incompatible. Substantively, the analysis focuses on the lack hand crime waveofviolence and extortion which was closely associated with Italian settlements in American and Canadian cities during the first two decades of the 20th century. Extensive use is made of contemporary press reports. The black hand crime wave, it is argued, reflected both a growing use onthe part of journalists and other social commentators of the lack hand label to describea wide array of crime and disorder problems in Italian communities, and the increasing use by motivated offenders of black hand methodology.",
month =  jan,
year =  2003,
url = "https://www.tandfonline.com/doi/abs/10.1080/10639620390117192",
file = "All_Papers/Published_Journal/J_TF1505/Sacco2003_05580.pdf",
keywords = "APPLIED sociology; BLACK Hand (United States); CRIME; ORGANIZED crime; SOCIAL problems; UNITED States;J\_TF1505",
doi = "10.1080/10639620390117192"
}

@ARTICLE{Rudolph1998-CausalVersusExistentialAttributionsDifferentPerspectivesOnHighlyNegativeEvents-..-ng,
title = "Causal versus existential attributions: Different perspectives on highly negative events",
author = "Rudolph, Udo and Steins, Gisela",
journal = "Basic and applied social psychology",
publisher = "Informa UK Limited",
address = "Philadelphia, PA",
volume =  20,
number =  3,
pages = "191-205",
abstract = "In this article, we examine attributions of extremely negative events such as an HIV infection, both from the perspective of the infected person as well as from the perspective of noninfected observers. The impetus for these studies is the observation that victims of highly negative events often refer to attributions such as poetic justice or personal destiny. These attributions are distinguished from causal attributions and are labeled existential attributions. In Study 1, we analyze whether existential attributions are indeed prevalent among persons infected with HIV. In Studies 2, 3, and 4, we examine the evaluation of such existential attributions from the perspective of an outside observer. Results show that persons infected with HIV indeed refer to existential attributions to explain their infection, whereas uninvolved observers predominantly reject these attributions. Moreover, Studies 2 and 3 reveal that perspective-taking ability, when measured as a stable person disposition, does not foster an understanding of existential attributions. However, as is shown in Study 4, situational determinants of the observer's perspective taking-such as the perception of one's own risk of becoming infected with HIV-promotes an understanding of the possible functions of existential attributions. Results are discussed with respect to the veridicality and functionality of existential attributions as well as their therapeutic implications.",
month =  sep,
year =  1998,
url = "https://www.tandfonline.com/doi/abs/10.1207/s15324834basp2003_2",
file = "All_Papers/Published_Journal/J_TF1505/Rudolph1998_11671.pdf",
keywords = "J\_TF1505;Basic Appl Soc Psych",
doi = "10.1207/s15324834basp2003\_2"
}

