keywords = "American Journal of Community Psychology",
doi = "10.1007/s10464-014-9639-1",
language = "en"
}

@ARTICLE{Smith2013-MeasuringCollectiveEfficacyAmongChildrenInCommunity-basedAfterschoolProgramsExploringPathwaysTowardPreventionAndPositiveYouthDevelopment-..-mj,
title = "Measuring collective efficacy among children in community-based afterschool programs: exploring pathways toward prevention and positive youth development",
author = "Smith, Emilie Phillips and Osgood, D Wayne and Caldwell, Linda and Hynes, Kathryn and Perkins, Daniel F",
