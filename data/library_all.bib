@ARTICLE{Ding2012-IsFearOfStrangersRelatedToPhysicalActivityAmongYouth-..-hx,
title = "Is fear of strangers related to physical activity among youth?",
author = "Ding, Ding and Bracy, Nicole L and Sallis, James F and Saelens, Brian E and Norman, Gregory J and Harris, Sion Kim and Durant, Nefertiti and Rosenberg, Dori and Kerr, Jacqueline",
