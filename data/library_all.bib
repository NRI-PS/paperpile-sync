file = "All_Papers/30_ReviewE/333_Vehicle/Cops2011_07676.pdf;All_Papers/30_ReviewE/333_Vehicle/Copes2006_07676.pdf",
keywords = "AUTOMOBILE theft; CRIMINALS; CRIME prevention; THEFT from motor vehicles; AUTOMOBILE keys; BURGLARY protection;333\_Vehicle;British Journal of criminology;MVT;\_\_\_202403\_自動車盗論文",
doi = "10.1093/bjc/azl001",
