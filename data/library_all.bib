}

@ARTICLE{Decker1993-AWomansPlaceIsInTheHomeFemalesAndResidentialBurglary-..-iv,
title = "A woman's place is in the home: Females and residential burglary",
author = "Decker, Scott and Wright, Richard and Redfern, Allison and Smith, Dietrich",
journal = "Justice quarterly",
publisher = "Informa UK Limited",
volume =  10,
number =  1,
pages = "143-162",
abstract = "Little is known about the nature of women's participation in residential burglary, an offense statistically dominated by males. This paper examines women's involvement in residential burglary by comparing the characteristics of female burglars to those of their male counterparts and by outlining a typology of female burglars which emphasizes their roles during offenses. In some respects, female and male burglars do not appear to differ significantly. Nevertheless, the results suggest that important differences also may exist. Most important, the findings demonstrate that women's involvement in residential burglary, like men's, is marked by diversity. The theoretical implications of these findings are discussed.",
