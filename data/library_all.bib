file = "All_Papers/Other/Paternoster1998_03501.pdf",
doi = "10.1023/a:1023024120766"
}

@ARTICLE{Parker2004-AContextualStudyOfRacialProfilingAssessingTheTheoreticalRationaleForTheStudyOfRacialProfilingAtTheLocalLevel-..-qd,
