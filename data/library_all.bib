keywords = "HELP-seeking behavior; SEXUAL assault; TEENAGERS -- Sexual behavior; DISCLOSURE; SEXUAL assault nurse examiners; SCHOOL personnel management; Adolescent sexual assault; Formal help-seeking;320\_ST実証研究;American Journal of Community Psychology",
doi = "10.1007/s10464-013-9577-3",
language = "en"
}

@ARTICLE{Foa2000-PsychologicalAndEnvironmentalFactorsAssociatedWithPartnerViolence-..-qv,
title = "Psychological and environmental factors associated with partner violence",
author = "Foa, Edna B and Cascardi, Michele and Zoellner, Lori A and Feeny, Norah C",
journal = "Trauma, violence \& abuse",
