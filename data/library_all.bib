@ARTICLE{Sandman1994-HighRiskOrLowHowLocationOnARiskLadderAffectsPerceivedRisk-..-gq,
title = "High risk or low: how location on a ``risk ladder'' affects perceived risk",
author = "Sandman, P M and Weinstein, N D and Miller, P",
journal = "Risk analysis: an official publication of the Society for Risk Analysis",
publisher = "Wiley",
volume =  14,
number =  1,
pages = "35-45",
abstract = "Efforts to explain risk magnitude often rely on a ``risk ladder'' in which exposure levels and associated risk estimates are arrayed with low levels at the bottom and high ones at the top. Two experiments were conducted to test the hypothesis that perceived threat and intended mitigation vary with the location of the subject's assigned level on the risk ladder. Subjects were New Jersey homeowners, asked to assume a particular level of radon or asbestos contamination in their homes, to read a brochure explaining the risk, and then to complete a questionnaire. Both studies found that the difference between an assigned level one-quarter of the way up the ladder and the same level three-quarters of the way up the ladder significantly affected threat perception; the effect on mitigation intentions was significant in only one of the studies. Variations in assigned risk also affected threat perception and mitigation intentions. Variations in test magnitude (e.g., 15 fibers per liter vs. 450 fibers per cubic foot, roughly equivalent risks) had no effect, nor did the distinction between radon and asbestos affect the dependent variables. These findings suggest that communicators can design risk ladders to emphasize particular risk characteristics.",
month =  feb,
year =  1994,
url = "http://dx.doi.org/10.1111/j.1539-6924.1994.tb00026.x",
file = "All_Papers/50_Journal_E/International_Criminal_Justice_Review/RiskAnalysis/Sandman1994_08157.pdf",
keywords = "RiskAnalysis",
doi = "10.1111/j.1539-6924.1994.tb00026.x",
language = "en"
}

@ARTICLE{Alhakami1994-APsychologicalStudyOfTheInverseRelationshipBetweenPerceivedRiskAndPerceivedBenefit-..-tr,
title = "A psychological study of the inverse relationship between perceived risk and perceived benefit",
author = "Alhakami, A S and Slovic, P",
journal = "Risk analysis: an official publication of the Society for Risk Analysis",
publisher = "Wiley",
volume =  14,
number =  6,
pages = "1085-1096",
abstract = "Judgments of risk and judgments of benefit have been found to be inversely related. Activities or technologies that are judged high in risk tend to be judged low in benefit, and vice versa. In the present study, we examine this inverse relationship in detail, using two measures of relationship between risk and benefit. We find that the inverse relationship is robust and indicative of a confounding of risk and benefit in people's minds. This confounding is linked to a person's overall evaluation of an activity or technology. Theoretical and practical implications of this risk-benefit confounding are discussed.",
month =  dec,
year =  1994,
url = "http://dx.doi.org/10.1111/j.1539-6924.1994.tb00080.x",
file = "All_Papers/50_Journal_E/International_Criminal_Justice_Review/RiskAnalysis/Alhakami1994_08152.pdf",
