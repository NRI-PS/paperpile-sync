@ARTICLE{Miethe1990-OpportunityChoiceAndCriminalVictimizationATestOfATheoreticalModel-..-ht,
title = "Opportunity, choice, and criminal victimization: A test of a theoretical model",
author = "Miethe, Terance D and Meier, Robert F",
