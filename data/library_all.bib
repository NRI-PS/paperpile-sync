year =  2002,
url = "https://academic.oup.com/bjc/article-abstract/42/1/60/395058",
file = "All_Papers/50_Journal_E/British_Journal_of_criminology/Ohlemacher2002_09188.pdf",
keywords = "British Journal of criminology",
