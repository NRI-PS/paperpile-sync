@ARTICLE{Zavala2015-TheImportanceOfSocialLearningAndCriticalIncidentStressorsOnPoliceOfficersPerpetrationOfIntimatePartnerViolence-..-er,
title = "The importance of social learning and critical incident stressors on police officers’ perpetration of intimate partner violence",
author = "Zavala, Egbert and Melander, Lisa A and Kurtz, Don L",
journal = "Victims \& offenders",
