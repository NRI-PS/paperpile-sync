@ARTICLE{Wheeler2012-TheMovingHomeEffectAQuasiExperimentAssessingEffectOfHomeLocationOnTheOffenceLocation-..-ru,
title = "The moving home effect: A quasi experiment assessing effect of home location on the offence location",
author = "Wheeler, Andrew",
journal = "Journal of quantitative criminology",
