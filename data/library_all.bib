journal = "Social psychology quarterly",
publisher = "SAGE Publications",
volume =  44,
number =  1,
pages =  14,
abstract = "Thirty-two individuals who intervened in dangerous criminal episodes such as street muggings, armed robberies, and bank holdups, were interviewed at length and compared with a group of noninterveners matched for age, sex, education, and ethnic background. Interveners, in contrast to noninterveners, reported considerably more exposure to crime in terms of personal victimization and witnessing the victimizations of others. Crime interveners also were taller, heavier, and better trained to cope with crimes and emergencies, having had significantly more life-saving, medical, and police training; and were more likely to describe themselves as physically strong, aggressive, emotional, and principled. In spite of an intensive search for personality differences between the two groups, none were found. Results suggest that crime interveners are not prompted to action by notably strong humanitarian purpose or by antisocial aggressiveness, but rather act out of a sense of capability founded on training experiences and rooted in their personal strength.",
month =  mar,
year =  1981,
