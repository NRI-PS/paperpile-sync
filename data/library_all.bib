doi = "10.1016/j.jcrimjus.2018.11.002",
language = "en"
}

@ARTICLE{Law2014-BayesianSpatio-temporalModelingForAnalysingLocalPatternsOfCrimeOverTimeAtTheSmall-areaLevel-..-so,
