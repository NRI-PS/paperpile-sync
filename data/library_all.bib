keywords = "Crime Prevention; CPTED Scale; Fear; fear of crime; Human; Adulthood (18 yrs \& older); Quantitative Study; Natural Crime Victimization Survey; environmental design; victimization; Middle Age (40-64 yrs); 4200:Forensic Psychology \& Legal Issues; Empirical Study; 4000:Engineering \& Environmental Psychology; Malaysia; Environmental Planning; British Crime Survey; Male; Female;301\_3;jep\_org;2012\_jsep\_review\_root;jep;301\_ComCrm;J Environ Psychol",
