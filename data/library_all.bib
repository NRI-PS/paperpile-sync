@ARTICLE{Foshee2004-LongitudinalPredictorsOfSeriousPhysicalAndSexualDatingViolenceVictimizationDuringAdolescence-..-zp,
title = "Longitudinal predictors of serious physical and sexual dating violence victimization during adolescence",
author = "Foshee, Vangie Ann and Benefield, Thad Steven and Ennett, Susan T and Bauman, Karl E and Suchindran, Chirayath",
journal = "Preventive medicine",
