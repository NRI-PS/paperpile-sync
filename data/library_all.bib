@ARTICLE{Jackson2021-CenteringRaceInProceduralJusticeTheoryStructuralRacismAndTheUnder-AndOver-policingOfBlackCommunities-..-gb,
title = "Centering race in procedural justice theory: Structural racism and the under- and over-policing of Black communities",
author = "Jackson, Jonathan and McKay, Tasseli and Cheliotis, Leonidas and Bradford, Ben and Fine, Adam and Trinkner, Rick",
journal = "SocArXiv",
abstract = "Objective: To centre race in procedural justice theory by incorporating perceptions of the under- and over-policing of Black communities into the framework. Hypotheses: Perceptions of the under- and over-policing of Black communities predict legitimacy, adjusting for perceptions of procedural justice, distributive justice and bounded authority. Identification with the Black Lives Matter (BLM) movement moderates the partial associations between legitimacy and perceptions of the under- and over-policing of Black communities. Findings pertain to both Black and White research participants alike.Method: A cross-sectional quota sample survey of 1,500 US residents was conducted just after the police killing of George Floyd in 2020. In addition to fielding relatively standard measures of legitimacy, procedural justice, distributive justice and bounded authority, we used new measures of under- and over-policing of Black communities and identification with the BLM cause. Data were analysed using structural equation modelling (SEM) and latent moderated SEM.Results: Perceptions of under- and over-policing of Black communities predicted legitimacy, alongside procedural justice, distributive justice and bounded authority. When people identified with BLM, the relationships between legitimacy and perceptions of the under- and over-policing of Black communities were stronger compared to when people did not identify with BLM. All these results held among Black and White study participants.Conclusions: Incorporating perceptions of the under- and over-policing of Black communities into procedural justice theory is one way to include racialised policing into the framework. The under- and over-policing of Black communities may carry racially-directed messages of diminishment, domination and neglect as well as general messages of unfairness and exclusion that delegitimize the police themselves and the state they represent.",
month =  "1~" # apr,
year =  2021,
url = "https://www.researchgate.net/publication/350579503",
file = "All_Papers/30_ReviewE/360_Trust/Jackson2021_XXXXX.pdf",
keywords = "360\_Trust",
doi = "10.31235/osf.io/kgwhc"
}

