@ARTICLE{Marchant2005-WhatWorksACriticalNoteOnTheEvaluationOfCrimeReductionInitiatives-..-ga,
title = "What works? A critical note on the evaluation of crime reduction initiatives",
author = "Marchant, Paul",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  7,
number =  2,
pages = "7-13",
abstract = "This article discusses the important differences between evaluating area-based crime reduction interventions through comparison of areas, and evaluating treatment effectiveness by a classic randomised controlled trial (RCT). The differences must be respected in the analysis of data. Wrong results will be given for a comparative area- based crime reduction trial if it is thought of as an RCT. The problem with evaluations which compare areas, one with an intervention and one without, is that such studies are neither randomised nor controlled, and the crime events being counted are correlated rather than statistically independent. Wrongly using those methods which are appropriate for an RCT will give misleading results. Statistical uncertainties will tend to be large and poorly determined, and statistical biases problematic because of the lack of equivalence between areas at the outset. Crime studies need to be appropriately designed to avoid such problems if costly mistakes are to be avoided.",
month =  "1~" # apr,
year =  2005,
url = "https://link.springer.com/content/pdf/10.1057/palgrave.cpcs.8140214.pdf",
file = "All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/palgrave.cpcs.8140214.pdf",
