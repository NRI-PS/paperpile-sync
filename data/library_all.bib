file = "All_Papers/30_ReviewE/320_ST実証研究/Leone2019_16866.pdf",
keywords = "Emergency department; First line screening; Gender-based violence; Patterns of diagnoses; Social network analysis;320\_ST実証研究",
doi = "10.1186/s12889-019-6797-y",
language = "en"
}

