title = "Assessing survey items on social norms relating to dating and relationship violence and to gender: Cognitive interviews with young people in England",
author = "Meiksin, Rebecca and Ponsford, Ruth and Kyegombe, Nambusi and Kohli, Anjalee and Bonell, Chris",
