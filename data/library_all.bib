}

@ARTICLE{Pelfrey2007-LocalLawEnforcementTerrorismPreventionEffortsAStateLevelCaseStudy-..-vf,
title = "Local law enforcement terrorism prevention efforts: A state level case study",
author = "Pelfrey, Jr, William V",
journal = "Journal of criminal justice",
publisher = "Elsevier BV",
volume =  35,
number =  3,
pages = "313-321",
abstract = "Although law enforcement agencies across the nation have assumed part of the responsibility in the fight against terrorism, significant confusion exists as to the role of local law enforcement. While some agencies have taken steps towards terrorism prevention, little data has been collected on which agencies have taken the greatest steps, how those agencies have changed, and how other agencies should direct their activity. This case study of law enforcement census data from a single state considered variations in terrorism preparedness and predictors of preparedness. Agency size, presence of funding, and other variables significantly predict levels of terrorism preparedness. Important policy implications such as the distribution of funding and which agencies should be working towards terrorism preparedness are discussed.",
