}

@ARTICLE{Liu2011-DoesTheLoveOfMoneyModerateTheRelationshipBetweenPublicServiceMotivationAndJobSatisfactionTheCaseOfChineseProfessionalsInThePublicSector-..-xj,
title = "Does the love of money moderate the relationship between public service motivation and job satisfaction? The case of Chinese professionals in the public sector",
