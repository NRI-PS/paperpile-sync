@ARTICLE{Wolfer2001-StrengtheningCommunitiesNeighborhoodWatchAndTheElderlyInAPennsylvaniaTown-..-od,
title = "Strengthening communities: Neighborhood watch and the elderly in a Pennsylvania town",
author = "Wolfer, Loreen",
