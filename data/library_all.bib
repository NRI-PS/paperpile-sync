keywords = "ODARA; police; field study; predictive validity; intimate partner violence; Police Personnel; Recidivism; Risk Assessment; Law Enforcement; Psychometrics; Risk Factors; Test Reliability; Test Validity; Violence;320\_ST実証研究",
