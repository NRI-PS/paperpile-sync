@ARTICLE{Schwirian1993-NeighboringResidentialSatisfactionAndPsychologicalWell-beingInUrbanElders-..-no,
title = "Neighboring, residential satisfaction, and psychological well-being in urban elders",
author = "Schwirian, Kent P and Schwirian, Patricia M",
journal = "Journal of community psychology",
publisher = "Wiley",
volume =  21,
number =  4,
pages = "285-299",
abstract = "The purpose of this paper is to ascertain the relative effects of neighboring and residential satisfaction on the psychological well‐being of urban elders. It also examines these relationships within the context of the elders' personal resources —socioeconomic status, health, and mobility. The data were obtained from a random digit‐dial sample of 254 noninstitutionalized urban elders living in the Columbus, Ohio, metropolitan area. Based on a structural equation analysis using Bender's EQS, the findings show limited support for the neighborhood effects. However, these effects did not hold up when personal resources were included in the model. Thus it is concluded that the relationship between residential satisfaction and psychological well‐being is an artifact of their mutual relationship with personal resources. People with health, money, and mobility have high psychological well‐being, and they also have the resources to assure themselves of a favorable residence—one in which they feel safe, are satisfied with the physical condition of the place, have solid housing that meets their needs, and are as close as they desire to things, institutions, and people that matter to them.",
month =  oct,
year =  1993,
url = "https://onlinelibrary.wiley.com/doi/abs/10.1002/1520-6629(199310)21:4%3C285::AID-JCOP2290210405%3E3.0.CO;2-Y",
file = "All_Papers/Other/Schwirian1993_04314.pdf",
doi = "10.1002/1520-6629(199310)21:4<285::aid-jcop2290210405>3.0.co;2-y",
language = "en"
}

@ARTICLE{vanDerWurff1989-FearOfCrimeInResidentialEnvironmentsTestingASocialPsychologicalModel-..-ee,
title = "Fear of crime in residential environments: Testing a social psychological model",
author = "van der Wurff, Adri and van Staalduinen, Leendert and Stringer, Peter",
journal = "The Journal of social psychology",
publisher = "Informa UK Limited",
volume =  129,
number =  2,
pages = "141-160",
abstract = "Abstract We examined fear of crime in the residential environment from a theoretical and social psychological perspective by constructing a model that relates feelings of unsafety to attributions about self, the potential criminal, and the situation in which the criminal act might occur. Using data from a questionnaire field survey of 440 residents in four urban neighborhoods, the model was compared with a socio-demographic alternative (comprising such variables as gender, age, and educational level). LISREL, a relatively new method of analysis that takes measurement error into account, indicated that the model has superior explanatory power and greater in-terpretability. Multiple regression analyses confirmed these results and point to ways in which operationalization of the theoretical model might be improved.",
