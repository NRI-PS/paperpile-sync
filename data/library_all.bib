language = "en"
}

@ARTICLE{George2001-TheImpactOfCrimeOnInternationalTouristNumbersToCapeTown-..-gl,
title = "The impact of crime on international tourist numbers to cape town",
author = "George, Richard",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  3,
number =  3,
pages = "19-29",
abstract = "Cape Town, a major tourism destination, is under the spotlight due to its susceptibility to crime committed against tourists. The ‘Mother City’ of South Africa, along with Durban and Johannesburg, is increasingly perceived to be an unsafe place to visit. Street crime, car hijacking, petty crime, muggings and acts of serious violence have continued to increase. Furthermore, there has been a spate of bombings—21 to be exact—in and around Cape Town during the last two years. Between 1998 and 2000 these attacks have left three people dead and 105 injured, and have threatened the region's economic development and in particular its tourism industry. The most devastating of these incidences was a pipe bomb at the Planet Hollywood restaurant at the V \& A Waterfront—Cape Town's major tourist venue—which killed two people and seriously injured many, including tourists. This paper examines the effects of this incident, along with the escalation of violent crime in the Cape Town region, on its hospitality sector, and discusses recent crime prevention measures.",
month =  "1~" # jul,
year =  2001,
url = "https://doi.org/10.1057/palgrave.cpcs.8140095",
keywords = "CPCS814;\_\_work\_PDF登録\_CPCS",
doi = "10.1057/palgrave.cpcs.8140095",
