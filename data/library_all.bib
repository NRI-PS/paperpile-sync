@ARTICLE{Solomon1982-TheEffectsOfBystandersAnonymitySituationalAmbiguityAndVictimsStatusOnHelping-..-tx,
title = "The effects of bystander's anonymity, situational ambiguity, and victim's status on helping",
author = "Solomon, Linda Zener and Solomon, Henry and Maiorca, Joseph",
journal = "The Journal of social psychology",
publisher = "Informa UK Limited",
volume =  117,
number =  2,
pages = "285-294",
abstract = "Summary Milgram has suggested that urban dwellers are overloaded with sensory input. They adapt to this situation by ignoring low priority inputs. This would cause urban people to be anonymous, and possibly affect their willingness to help. In Study 1, it was argued that anonymous people are freed from social pressure to behave normatively, and hence, it was predicted that anonymity would discourage helping behavior. In a laboratory setting, groups of three strangers (one S and two confederates), supposedly taking part in an ESP study, witnessed an emergency. Groups in the anonymous-hood condition wore hoods and lab coats, while those in the identifiable condition wore ordinary clothes and introduced themselves to one another. A third set of groups (identifiable-hood) served as a control for the effects of the hoods per se. As predicted, helping was significantly slower and significantly less likely in the anonymous-hood condition than in the identifiable condition. In the second study, the overload notion was utilized to suggest that urban dwellers would be less helpful than suburban, and that urban dwellers would be more likely to “tune out” a low priority input in the form of a low status victim. A well dressed (high status) or poorly dressed (low status) “lost” child approached bystanders in urban and suburban areas asking them to call his home. Urban dwellers were the less helpful, and the urban-suburban difference was most pronounced for the low status child. In the third study, it was suggested that “overloaded” urban dwellers would be less likely to help if the help request were ambiguous rather than clearly stated. Urban Ss were reached by phone, and either asked if this was the number for the time, or asked what the time was, or presented with a combination of the two questions. Helping (i.e., giving the time) was significantly greater in the last two conditions than in the first, supporting the notion that ambiguity (i.e., costly inputs) decreases help.",
month =  "1~" # aug,
year =  1982,
url = "https://www.tandfonline.com/doi/abs/10.1080/00224545.1982.9713438",
file = "All_Papers/30_ReviewE/321_SA実証研究/Solomon1982_50191.pdf",
keywords = "321\_SA実証研究;Bystander\_324;\_\_\_202504\_tmgsocpsy;324から",
doi = "10.1080/00224545.1982.9713438",
language = "en"
}

@ARTICLE{Xie2019-CrimeVictimsDecisionsToCallThePolicePastResearchAndNewDirections-..-gs,
