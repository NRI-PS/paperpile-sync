@ARTICLE{Russell2006-PoliceAndVictimPerspectivesOnEmpowermentOfDomesticViolenceVictims-..-md,
title = "Police and victim perspectives on empowerment of domestic violence victims",
author = "Russell, Mary and Light, Linda",
journal = "Police quarterly",
