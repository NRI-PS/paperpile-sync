url = "https://www.tandfonline.com/doi/abs/10.1080/10683169708410826",
file = "All_Papers/Published_Journal/J_TF1505/Bilsky1997_07165.pdf",
keywords = "criminal victimization \& fear of crime, adults; Crime; Fear; Victimization;J\_TF1505",
doi = "10.1080/10683169708410826",
language = "en"
}

