@ARTICLE{Frank2017-ExaminingPoliceOfficerWorkStressUsingTheJobDemands-resourcesModel-..-ni,
title = "Examining police officer work stress using the job demands–resources model",
author = "Frank, James and Lambert, Eric G and Qureshi, Hanif",
