@ARTICLE{Pedneault2017-MyopicDecisionMakingAnExaminationOfCrimeDecisionsAndTheirOutcomesInSexualCrimes-..-yj,
title = "Myopic decision making: An examination of crime decisions and their outcomes in sexual crimes",
author = "Pedneault, Amelie and Beauregard, Eric and Harris, Danielle A and Knight, Raymond A",
journal = "Journal of criminal justice",
