@ARTICLE{Williamson2005-YoungOffendersSchoolsAndTheNeighbourhoodANewApproachToData-analysisForCommunityPolicing-..-uv,
title = "Young offenders, schools and the neighbourhood: a new approach to data‐analysis for community policing",
author = "Williamson, Tom and Ashby, David I and Webber, Richard",
