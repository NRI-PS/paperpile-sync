@ARTICLE{Branas2018-CitywideClusterRandomizedTrialToRestoreBlightedVacantLandAndItsEffectsOnViolenceCrimeAndFear-..-wd,
title = "Citywide cluster randomized trial to restore blighted vacant land and its effects on violence, crime, and fear",
author = "Branas, Charles C and South, Eugenia and Kondo, Michelle C and Hohl, Bernadette C and Bourgois, Philippe and Wiebe, Douglas J and MacDonald, John M",
