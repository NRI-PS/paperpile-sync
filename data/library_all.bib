keywords = "352\_PropensityScore",
doi = "10.1177/003335490812300614",
language = "en"
}

@ARTICLE{Hornik2006-PersonalInfluenceAndTheEffectsOfTheNationalYouthAnti-DrugMediaCampaign-..-yt,
