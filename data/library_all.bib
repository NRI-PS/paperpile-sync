@ARTICLE{Zhu2012-WhenDoPeopleFeelMoreRiskTheEffectOfAmbiguityToleranceAndMessageSourceOnPurchasingIntentionOfEarthquakeInsurance-..-ft,
title = "When do people feel more risk? The effect of ambiguity tolerance and message source on purchasing intention of earthquake insurance",
author = "Zhu, Dongqing and Xie, Xiaofei and Xie, Jiaqiu",
