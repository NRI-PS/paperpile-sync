language = "en"
}

@ARTICLE{Summers2017-DoesTheConfigurationOfTheStreetNetworkInfluenceWhereOutdoorSeriousViolenceTakesPlaceUsingSpaceSyntaxToTestCrimePatternTheory-..-mh,
title = "Does the configuration of the Street network influence where outdoor serious violence takes place? Using space syntax to test crime pattern theory",
author = "Summers, Lucia and Johnson, Shane D",
journal = "Journal of quantitative criminology",
