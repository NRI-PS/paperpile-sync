@ARTICLE{Williams2003-PoliceSurveillanceAndTheEmergenceOfCCTVInThe1960s-..-hm,
title = "Police surveillance and the emergence of CCTV in the 1960s",
author = "Williams, Chris A",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  5,
number =  3,
pages = "27-37",
abstract = "Although most commentators have dated their arrival to the 1980s, the use of public CCTV systems by the British police has a history that stretches back 40 years. Initial experiments in the 1960s with CCTV in London and Liverpool were unsuccessful due to the high cost of cabling. The first permanent use was the surveillance of political demonstrations in central London. This fitted into existing police operational requirements and structures, and continued a process of centralization and mechanization that began in the 1930s with working practices originally deployed in the First World War. The arrival of police surveillance systems in the 1960s thus calls into question any easy theoretical association between them and ‘post-industrial society’.",
month =  "1~" # jul,
year =  2003,
url = "https://link.springer.com/article/10.1057/palgrave.cpcs.8140153",
file = "All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/palgrave.cpcs.8140153.pdf",
keywords = "CPCS1999-2009;CPCS814;Crime Prevention and Community Safety",
doi = "10.1057/palgrave.cpcs.8140153",
language = "en"
}

@ARTICLE{Mackay2003-MultipleTargetsTheReasonsToSupportTown-centreCCTVSystems-..-qq,
title = "Multiple targets: The reasons to support town-centre CCTV systems",
author = "Mackay, David",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  5,
number =  3,
pages = "39-48",
abstract = "Little attempt has been made to investigate the reasons for supporting town-centre CCTV systems. Attention has normally focused on crime reduction and potential infringement of civil liberties. This essay concentrates on the public reasons that have been given for supporting it.The reasons behind this support are studied and examples are produced; these have seldom attracted headlines but form the basis for the support given by all partners. The study shows that CCTV was sold as a political response to the law and order debate. Its true purpose is shown to be an amalgam of dealing with public disorder, the fear of crime, improving economic benefits and town centre management issues. All of these relate to self-interest on the part of the supporters. These findings are confirmed after a series of non-structured interviews in the case study.",
month =  "1~" # jul,
year =  2003,
url = "https://link.springer.com/article/10.1057/palgrave.cpcs.8140154",
file = "All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/palgrave.cpcs.8140154.pdf",
