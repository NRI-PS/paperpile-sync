language = "en"
}

@ARTICLE{Raaijmakers2022-AssessingThePredictiveValidityOfARiskAssessmentInstrumentForRepeatVictimizationInTheNetherlandsUsingPriorPoliceContacts-..-ro,
title = "Assessing the predictive validity of a risk assessment instrument for repeat victimization in The Netherlands using prior police contacts",
author = "Raaijmakers, Niels and Geurts, Roos and Delsing, Marc Jmh and Bosma, Alice K and Wientjes, Jacqueline A M and Spapens, Toine and Scholte, Ron H J",
