}

@ARTICLE{Lee2011-TheRoleOfDescriptiveNormWithinTheTheoryOfPlannedBehaviorInPredictingKoreanAmericansExerciseBehavior-..-se,
title = "The role of descriptive norm within the theory of planned behavior in predicting Korean Americans' exercise behavior",
author = "Lee, Hyo",
