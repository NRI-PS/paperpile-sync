@ARTICLE{Smith2022-AssessingPoliceStopsOfPedestriansTowardANewGenerationOfBenchmarks-..-er,
title = "Assessing police stops of pedestrians: Toward a new generation of benchmarks",
author = "Smith, Michael R and Tillyer, Rob and Smith, Mitchell and Lloyd, Caleb D",
