year =  2012,
url = "https://www.tandfonline.com/doi/abs/10.1080/19475683.2012.691902",
file = "All_Papers/Published_Journal/J_TF1505/Kikuch2012_12995.pdf",
keywords = "J\_TF1505;業績一覧\_01論文",
doi = "10.1080/19475683.2012.691902",
language = "en"
}

