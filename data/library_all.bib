abstract = "This report examines the relationship between criminal victimization and fear of crime. Past research has been surprisingly inconclusive about this issue, and some people's fears have been branded “irrational” because the two did not appear to be tightly linked. However, the data analyzed here indicate that victimization affects both fear-related attitudes and behavior in a clear and consistent manner. This report also suggests that the impact of victimization is relatively uniform. Some research has indicated that certain groups are especially affected by crime, a claim that might be used to justify special treatment for selected victims and has been used to support demands for special “treatment” of selected offenders. However, the strong effects of victimization registered in these data were not differentially distributed across subgroups. In sum, most people do learn from their experiences, although other kinds of learning are rational as well.",
month =  jan,
year =  1987,
url = "https://journals.sagepub.com/doi/full/10.1177/0011128787033001008",
file = "All_Papers/30_ReviewE/303/Skogan1987_08348.pdf;All_Papers/30_ReviewE/303/Skogan1987_08348.pdf",
keywords = "FEAR of crime; VICTIMS of crimes; Families with special problems -- families with criminal offenders; Psychological victimization effects; Psychology, sociology and anthropology -- psychology; Victim reactions to crime;303;a\_犯罪予防の社会心理学\_root;犯罪予防の社会心理学\_210\_大田調査\_2004\_犯社研(3章);301\_ComCrm;301\_4;Crime Delinquency\_●Sage",
doi = "10.1177/0011128787033001008",
language = "en"
}

