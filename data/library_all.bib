doi = "10.1177/0011128714555606",
language = "en"
}

@ARTICLE{Lenzi2013-HowNeighborhoodStructuralAndInstitutionalFeaturesCanShapeNeighborhoodSocialConnectednessAMultilevelStudyOfAdolescentPerceptions-..-go,
