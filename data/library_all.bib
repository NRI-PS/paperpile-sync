keywords = "COVID-19; Crime; Exceptional events; Point pattern analysis; Multinomial logistic regression; Saskatoon;J Crim Justice;308\_STC",
doi = "10.1016/j.jcrimjus.2022.101881",
language = "en"
}

@ARTICLE{Kuen2024-ReassessingTheProcess-basedModelDoProceduralJusticeAndPoliceLegitimacyLeadToReportingNeighborhoodProblemsToThePoliceOverTime-..-ec,
