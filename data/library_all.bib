keywords = "Case clearance; Difference-in-differences; Investigations; Police technology; Real-time crime centers;J Crim Justice;318\_介入実験\_Policing",
doi = "10.1016/j.jcrimjus.2023.102145",
language = "en"
}

@ARTICLE{Mancini2023-PublicAssessmentsOfTheCriminalJusticeSystemInAddressingMentalHealth-..-dh,
