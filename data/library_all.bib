}

@ARTICLE{Ariel2017-LoweringTheThresholdOfEffectiveDeterrence-TestingTheEffectOfPrivateSecurityAgentsInPublicSpacesOnCrimeARandomizedControlledTrialInAMassTransitSystem-..-lz,
