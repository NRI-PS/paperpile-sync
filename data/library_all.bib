file = "All_Papers/30_ReviewE/320_ST実証研究/Vives-Cases2014_17981.pdf;All_Papers/30_ReviewE/320_ST実証研究/Vives-Cases2014_17981.pdf",
keywords = "320\_ST実証研究",
doi = "10.1093/eurpub/ckt127",
language = "en"
}

