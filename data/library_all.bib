title = "Identity, legitimacy and cooperation with police: Comparing general-population and street-population samples from London",
author = "Kyprianides, Arabella and Bradford, Ben and Jackson, Jonathan and Yesberg, Julia and Stott, Clifford and Radburn, Matthew",
