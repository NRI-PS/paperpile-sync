title = "'Take the stairs instead of the escalator': effect of environmental prompts on community stair use and implications for a national 'Small Steps' campaign",
author = "Dolan, M S and Weiss, L A and Lewis, R A and Pietrobelli, A and Heo, M and Faith, M S",
journal = "Obesity reviews: an official journal of the International Association for the Study of Obesity",
