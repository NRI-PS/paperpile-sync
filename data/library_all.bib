@ARTICLE{Riddell2022-Re-openingDallasAShort-termEvaluationOfCOVID-19RegulationsAndCrime-..-jh,
title = "Re-opening Dallas: A short-term evaluation of COVID-19 regulations and crime",
author = "Riddell, Jordan R and Piquero, Alex R and Kaukinen, Catherine and Bishopp, Stephen A and Piquero, Nicole Leeper and Narvey, Chelsey S and Iesue, Laura",
