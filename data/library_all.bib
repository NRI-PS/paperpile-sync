language = "en"
}

@ARTICLE{Hoeboer2023-TheImpactOfCOVID-19OnCrimeASystematicReview-..-kv,
title = "The impact of COVID-19 on crime: A systematic review",
author = "Hoeboer, C M and Kitselaar, W M and Henrich, J F and Miedzobrodzka, E J and Wohlstetter, B and Giebels, E and Meynen, G and Kruisbergen, E W and Kempes, M and Olff, M and de Kogel, C H",
