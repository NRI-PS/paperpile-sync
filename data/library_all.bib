language = "en"
}

@ARTICLE{Lind2015-TheValue-belief-normTheoryPersonalNormsAndSustainableTravelModeChoiceInUrbanAreas-..-cg,
title = "The value-belief-norm theory, personal norms and sustainable travel mode choice in urban areas",
author = "Lind, Hans Brende and Nordfjærn, Trond and Jørgensen, Stig Halvard and Rundmo, Torbjørn",
