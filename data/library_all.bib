@ARTICLE{Kirkby-Geddes2013-SocialCapitalAndCommunityGroupParticipationExaminingBridgingAndBondingInTheContextOfAHealthyLivingCentreInTheUKSocialCapitalAndCommunityGroupParticipation-..-uo,
