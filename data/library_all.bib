@ARTICLE{Phelps2021-TheRoleOfThePrivateSectorInCounter-terrorismAScopingReviewOfTheLiteratureOnEmergencyResponsesToTerrorism-..-hf,
title = "The role of the private sector in counter-terrorism: a scoping review of the literature on emergency responses to terrorism",
author = "Phelps, Matthew",
journal = "Security journal",
