@ARTICLE{Chalfin2023-ProfessionalMotivationsInThePublicSectorEvidenceFromPoliceOfficers-..-tu,
title = "Professional motivations in the public sector: Evidence from police officers",
author = "Chalfin, Aaron and Gonçalves, Felipe",
journal = "SSRN Electronic Journal",
abstract = "How do public sector workers balance their workplace motivations with private economic concerns? We study this question in the context of police arrests, among the most common and consequential government acts. We study two institutional features that change an officer’s private cost of making an arrest. First, arrests near the end of a shift more often require overtime work and pay, and we show that officers respond by reducing arrests and increasing arrest quality near shift-end. Second, arrests on days when an officer works a post-shift off-duty job have a higher opportunity cost, which we find causes a modest reduction in late-shift arrests. Combining these estimates in a dynamic model identifies officers’ implied trade-off between private and professional motivations. Officers exhibit a high valuation towards their work but balance it with a high cost to working additional police hours. Changes to overtime pay policy would lead to almost no change in officer arrest activity. Our findings highlight the first-order importance of aversion to overtime work for the quantity and quality of public sector work. JEL Codes: K42 ∗We are grateful to Bocar Ba, Jordi Blanes i Vidal, Jesse Bruhn, Amanda Geller, Sierra Kuzava, Ilyana Kuziemko, Adriana Lleras-Muney, Bentley MacLeod, Michael Makowsky, Conrad Miller, Michael Mueller-Smith, Emily Owens, Nicola Persico, Alessandra Voena, Till von Wachter, Emily Weisburst, and seminar participants at the Ottawa Applied Micro Lab (University of Ottawa/Carleton University), Princeton University, UCLA, APPAM, NBER Summer Institute, SEA, SOLE, and the Arnold Ventures’ Police Accountability Roundtable for helpful comments. We thank the Dallas Police Department and the Dallas County Attorney General’s office for sharing their records and Lieutenant Stephen Bishopp and Corporal Julie Martin for help with institutional details. Any remaining errors are our own. †University of Pennsylvania and NBER, achalfin@sas.upenn.edu ‡University of California, Los Angeles and NBER; fgoncalves@ucla.edu.",
month =  "1~" # dec,
year =  2023,
url = "https://www.ssrn.com/abstract=4675173",
file = "All_Papers/Other/w31985.pdf",
doi = "10.2139/ssrn.4675173"
}

