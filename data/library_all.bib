}

@ARTICLE{Nolan2011-NormativeMessagesPromotingEnergyConservationWillBeUnderestimatedByExperts...UnlessYouShowThemTheData-..-fn,
title = "Normative messages promoting energy conservation will be underestimated by experts … unless you show them the data",
author = "Nolan, Jessica M and Kenefick, Jessica and Schultz, P Wesley",
