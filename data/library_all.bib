@ARTICLE{Kane2005-CompromisedPoliceLegitimacyAsAPredictorOfViolentCrimeInStructurallyDisadvantagedCommunities-..-on,
title = "Compromised police legitimacy as a predictor of violent crime in structurally disadvantaged communities",
author = "Kane, Robert J",
journal = "Criminology; an interdisciplinary journal",
