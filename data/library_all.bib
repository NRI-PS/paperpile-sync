}

@ARTICLE{Stallings2015-ExaminingPerceptionsOfCrimeAndQualityOfLifeByResidentsLivingInADrugMarketInterventionNeighborhood-..-en,
title = "Examining perceptions of crime and quality of life by residents living in a drug market intervention neighborhood",
author = "Stallings, Robert P and Hawkins, Paul M and Ward, Kyle C",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  17,
number =  3,
pages = "166-188",
abstract = "Evaluations have shown that the Drug Market Intervention (DMI), when implemented correctly, can effectively reduce open-air drug markets (Kennedy and Wong; Rivers et al). Lacking from the research is a quantitative measurement of the impact of DMIs on residents’ perceptions of crime and safety. The Roanoke, VA, Police Department (RPD) surveyed residents living in a target area before and after the implementation of a DMI to gauge potential fluctuations in feelings of safety, concern for crime, the physical environment and sanitation. The current study conducted secondary data analyses of RPD survey results to further explore these relationships. The authors found statistically significant improvements in residents’ concern for crime, sanitation and the physical environment pre to post DMI. Future research and policy implications are discussed with inclusion of the importance of assessing levels of community informal social control before and after implementing DMI in order to strengthen evaluations of the program.",
month =  "1~" # aug,
year =  2015,
