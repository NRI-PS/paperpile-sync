url = "https://link.springer.com/article/10.1057/s41284-020-00236-4",
file = "All_Papers/50_Journal_E/Security_Journal/2020/s41284-020-00236-4.pdf",
keywords =  2020,
doi = "10.1057/s41284-020-00236-4",
language = "en"
}

@ARTICLE{Ikeanyibe2020-InteragencyCollaborationAndTheManagementOfCounter-insurgencyCampaignsAgainstBokoHaramInNigeria-..-wh,
title = "Interagency collaboration and the management of counter-insurgency campaigns against Boko Haram in Nigeria",
