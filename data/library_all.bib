}

@ARTICLE{OBrien2019-HomicideArrestRateTrendsInTheUnitedStatesTheContributionsOfPeriodsAndCohorts1965-2015-..-py,
title = "Homicide arrest rate trends in the United States: The contributions of periods and cohorts (1965–2015)",
