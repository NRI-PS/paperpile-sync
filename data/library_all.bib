file = "All_Papers/Other/Vecina2015_14318.pdf",
keywords = "Intimate Partner Violence (IPV); Moral psychology; Moral self-concept; Self-deception; Sacredness; Moral absolutism",
doi = "10.1016/j.avb.2015.04.013",
language = "en"
}

