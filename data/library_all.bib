@ARTICLE{Davies2021-VisiblyBetterTestingTheEffectOfEthnicAppearanceOnCitizenPerceptionsOfThePolice-..-yb,
title = "Visibly better? Testing the effect of ethnic appearance on citizen perceptions of the police",
author = "Davies, Tom and Bradford, Ben and Yesberg, Julia A and Pósch, Krisztián",
journal = "Policing \& society",
publisher = "Informa UK Limited",
volume =  31,
number =  9,
pages = "1133-1148",
abstract = "ABSTRACTEthnic minority officers continue to be underrepresented across UK police forces. Further, some ethnic minority groups consistently report lower levels of confidence in police compared to their White British counterparts. Although there is consensus that a more ethnically representative police service is a good idea, there is limited evidence in the UK on how the public perceives officers of different ethnic appearance, and how this relates to trust, confidence and legitimacy. This paper presents findings from an online experiment (n?=?260) exploring how ethnic appearance affects perceptions of police. Our findings offer rare empirical support for a more ethnically representative police force. First, across respondents, we found that Black officers were perceived significantly more favourably than White or Asian officers. Second, we found that Black respondents had more negative responses to White officers, yet there was little evidence that Black officers elicited more negative reactions from White or Asian respondents. We discuss the theoretical and practical implications of the findings.",
