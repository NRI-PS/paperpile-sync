file = "All_Papers/50_Journal_E/J_Crim_Justice/1-s2.0-S0047235219303241-main.pdf",
keywords = "Self-control; Police; Law enforcement; School; Intrusiveness;J Crim Justice",
doi = "10.1016/j.jcrimjus.2019.101635",
language = "en"
}

