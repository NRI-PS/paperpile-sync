url = "https://doi.org/10.1111/j.1745-9125.2010.00198.x",
file = "All_Papers/30_ReviewE/352_PropensityScore/Sharkey2010_09172.pdf",
keywords = "violence; residential mobility; neighborhoods;352\_PropensityScore;criminology",
doi = "10.1111/j.1745-9125.2010.00198.x",
language = "en"
}

