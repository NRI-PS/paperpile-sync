file = "All_Papers/30_ReviewE/304_RepeatVic/Area_and_individual_differences_in_personal_crime_victimization_incidenc_...__individual,_lifestyle_-_routine_activities_and_contextual_predictors.pdf;All_Papers/30_ReviewE/304_RepeatVic/Tseloni2015_16051.pdf;All_Papers/30_ReviewE/304_RepeatVic/Tseloni2015_15405.pdf",
keywords = "304\_RepeatVic;301\_ComCrm;301\_4;international Review of Victimology",
