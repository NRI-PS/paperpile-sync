url = "http://dx.doi.org/10.1177/0734016816670457",
file = "All_Papers/50_Journal_E/Crim_Justice_Rev/Kleck2016_15457.pdf",
keywords = "Crim Justice Rev",
doi = "10.1177/0734016816670457",
language = "en"
}

@ARTICLE{Freilich2015-BeccariaAndSituationalCrimePrevention-..-gw,
