author = "Kossowska, Małgorzata and Szwed, Paulina and Czernatowicz-Kukuczka, Aneta and Perek-Białas, Jolanta and Szumowska, Ewa and Kruglanski, Arie W and Gadowska, Kaja and Kamińska, Marta and Załuski, Wojciech",
