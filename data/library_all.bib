@ARTICLE{Li2010-AMultilevelAnalysisOfIndividualHouseholdAndNeighborhoodCorrelatesOfIntimatePartnerViolenceAmongLow-incomePregnantWomenInJeffersonCountyAlabama-..-pn,
title = "A multilevel analysis of individual, household, and neighborhood correlates of intimate partner violence among low-income pregnant women in Jefferson county, Alabama",
author = "Li, Qing and Kirby, Russell S and Sigler, Robert T and Hwang, Sean-Shong and Lagory, Mark E and Goldenberg, Robert L",
