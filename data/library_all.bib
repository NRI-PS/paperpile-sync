@ARTICLE{Rippetoe1987-EffectsOfComponentsOfProtection-motivationTheoryOnAdaptiveAndMaladaptiveCopingWithAHealthThreat-..-oy,
title = "Effects of components of protection-motivation theory on adaptive and maladaptive coping with a health threat",
