@ARTICLE{Ameral2020-AnAnalysisOfHelp-seekingPatternsAmongCollegeStudentVictimsOfSexualAssaultDatingViolenceAndStalking-..-gx,
title = "An analysis of help-seeking patterns among college student victims of sexual assault, dating violence, and stalking",
author = "Ameral, Victoria and Palm Reed, Kathleen M and Hines, Denise A",
journal = "Journal of interpersonal violence",
