file = "All_Papers/50_Journal_E/American_Journal_of_Community_Psychology/Flórez2016_50844.pdf",
keywords = "African Americans; Perceived neighborhood safety; Perceived neighborhood social cohesion; Pittsburgh, PA; Psychological distress;American Journal of Community Psychology",
