}

@ARTICLE{Mazeika2023-TheEffectOfUnreportedGun-relatedViolentCrimeOnCrimeHotSpots-..-jg,
title = "The effect of unreported gun-related violent crime on crime hot spots",
author = "Mazeika, David",
journal = "Security journal",
publisher = "Springer Science and Business Media LLC",
volume =  36,
number =  1,
pages = "101-117",
abstract = "Crime hot spots, the roughly 5\% of locations responsible for half of all crime in a municipality, have almost exclusively been documented and further studied using offenses reported to the police. However, more than half of all UCR Part 1 offenses go unreported, and thus, the study of crime and place is largely a study of a relatively small percentage of cases. The current work assesses the effect of unreported crime on the number, size, and location of gun-related violent crime (GRVC) hot spots in Trenton, New Jersey. GRVCs reported to the police are supplemented with data from ShotSpotter, an acoustic gun-detection technology. Using nearest neighbor hierarchical clustering, this study finds that 25\% of hot spots would be unknown to the Trenton Police Department absent ShotSpotter. There were no effects on the concentration and temporal trends, and the clusters identified with ShotSpotter were on average smaller and contained fewer incidents. The modest locational insights will have to be balanced with numerous and significant limitations of the system.",
