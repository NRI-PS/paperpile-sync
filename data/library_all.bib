@ARTICLE{Staller2023-ThePlanningAndReflectionOfPoliceUseOfForceTrainingAGermanCaseStudy-..-yu,
title = "The planning and reflection of police use of force training: a German case study",
author = "Staller, Mario S and Koerner, Swen and Heil, Valentina and Abraham, Andrew and Poolton, Jamie",
journal = "Security journal",
