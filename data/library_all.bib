author = "Crano, William D and Alvaro, Eusebio M and Siegel, Jason T",
booktitle = "Handbook of adolescent drug use prevention: Research, intervention strategies, and practice",
publisher = "American Psychological Association",
address = "Washington",
pages = "397-414",
abstract = "In this chapter, we suggest ways in which media campaigns can be developed and designed so that the validity of their outcomes may be assessed with a greater degree of confidence. We first briefly discuss the National Youth Anti-Drug Media Campaign (NYAMC), one of the country’s largest media-based campaigns using social marketing for health persuasion targeting youth drug prevention. This effort is intended to illustrate some of the decision points that must be navigated when mounting large-scale prevention campaigns of this type. We then turn to considerations of the nature of media effects, the outcomes that might be expected from health-persuasion social marketing campaigns, useful design options for developing and evaluating media campaigns, and a brief discussion of their strengths and weaknesses. The chapter is focused on design decisions that affect the quality of data obtained in evaluating campaign effects and on issues of message development that can make the difference between persuasive success or failure. The chapter also discusses quasi-experimental research designs that may prove useful when other rigorous design conditions are unavailable. The chapter is designed to cause readers to consider how, and the conditions under which, traditional mass media approaches should be exploited and when they should be avoided. We also provide an overview of theoretical issues in campaign development. Possessing this vital knowledge will help researchers elaborate the precise psychological mechanisms underlying campaign effects and their anticipated outcomes. By implication, theory also dictates which measures should be included in the campaign evaluation to accurately pinpoint the hypothesized causal processes that link social marketing efforts with behavior change. (PsycInfo Database Record (c) 2020 APA, all rights reserved)",
year =  2015,
url = "http://dx.doi.org/10.1037/14550-023",
keywords = "*Adolescent Development; *Program Development; *Program Evaluation; *Public Service Announcements; Substance Use Prevention;363\_publicity;PDFなし",
doi = "10.1037/14550-023"
}

