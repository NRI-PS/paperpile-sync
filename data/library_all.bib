keywords = "PTSD; anything related to sexual assault < sexual assault; male victims < sexual assault; mental health and violence; violence exposure",
doi = "10.1177/08862605211055151",
language = "en"
}

@ARTICLE{Basile2022-CharacteristicsAndImpactsOfSexualViolenceAndStalkingVictimizationByTheSamePerpetratorUsingANationallyRepresentativeSample-..-hk,
title = "Characteristics and impacts of sexual violence and stalking victimization by the same perpetrator using a nationally representative sample",
author = "Basile, Kathleen C and Smith, Sharon G and Wang, Jing and Friar, Norah",
journal = "Journal of aggression, maltreatment \& trauma",
