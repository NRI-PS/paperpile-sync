@ARTICLE{Thornton2005-UnderstandingTheOlderPersonsAwarenessAndExperienceOfDoorstepCrimeResultsOfANationalSurvey-..-gi,
title = "Understanding the older person's awareness and experience of doorstep crime: Results of a national survey",
author = "Thornton, Amanda and Hatton, Chris and Ralph, Lysa and Owen, Tom",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  7,
number =  1,
pages = "31-42",
abstract = "Police records suggest that on average almost 19,000 distraction burglaries are committed across England and Wales per year, although this is likely to under-report actual levels of distraction burglary targeting and victimisation. To investigate in more detail the extent of distraction burglary targeting and victimisation amongst older people, a national telephone survey of 3403 adults aged 60 and over across England, Wales and Scotland was conducted. Across the whole sample, 3.3 per cent of respondents reported themselves to have been a target of a potential distraction burglary in the previous year, with 1.1 per cent reporting the theft of property as a result. Older age groups reported themselves as more likely to be both targets and victims. There were also age, gender and socioeconomic differences in awareness of distraction burglary campaigns, home security and concern about answering the door. Scaling-up the responses to this survey would suggest approximately 400,000 distraction burglary attempts and 130,000 successful distraction burglaries in England, Scotland and Wales per year. A number of suggestions are made concerning the discrepancy between these figures and police records, including police recording, under-reporting and methodological issues within the survey. The considerable policy and practice implications of these figures are also discussed.",
month =  "1~" # jan,
year =  2005,
url = "https://link.springer.com/content/pdf/10.1057/palgrave.cpcs.8140207.pdf",
file = "All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/Thornton2005_XXXXX,.pdf",
keywords = "CPCS1999-2009;CPCS814;Crime Prevention and Community Safety",
