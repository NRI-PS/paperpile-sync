language = "en"
}

@ARTICLE{Holmberg2005-PolicingAndTheFeelingOfSafetyTheRiseandFallOfCommunityPolicingInTheNordicCountries-..-tm,
title = "Policing and the feeling of safety: The rise (and fall?) of community policing in the Nordic countries",
author = "Holmberg, Lars",
