@ARTICLE{Lussier2014-CommunityRe-entryAndThePathTowardDesistanceAQuasi-experimentalLongitudinalStudyOfDynamicFactorsAndCommunityRiskManagementOfAdultSexOffenders-..-cs,
title = "Community re-entry and the path toward desistance: A quasi-experimental longitudinal study of dynamic factors and community risk management of adult sex offenders",
