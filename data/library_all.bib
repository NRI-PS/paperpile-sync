language = "en"
}

@ARTICLE{Gebo2010-ReconceptualizingOrganizationalChangeInTheComprehensiveGangModel-..-lb,
title = "Reconceptualizing organizational change in the Comprehensive Gang Model",
author = "Gebo, Erika and Boyes-Watson, Carolyn and Pinto-Wilson, Sayra",
