keywords = "help-seeking; PTSD; intimate partner violence; abuser intervention programs; domestic violence; Help Seeking Behavior; Posttraumatic Stress Disorder; Survivors; Clients; Emotional Abuse; Intervention; Physical Abuse; Test Construction; Partners;320\_ST実証研究",
doi = "10.1037/vio0000126",
language = "en"
}

@ARTICLE{Sharp-Jeffs2018-LongJourneysTowardFreedomTheRelationshipBetweenCoerciveControlAndSpaceForAction-measurementAndEmergingEvidence-..-ku,
