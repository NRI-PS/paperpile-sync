@ARTICLE{Rogowska2020-ExaminingAnxietyLifeSatisfactionGeneralHealthStressAndCopingStylesDuringCOVID-19PandemicInPolishSampleOfUniversityStudents-..-zt,
title = "Examining anxiety, life satisfaction, general health, stress and coping styles during COVID-19 pandemic in polish sample of university students",
