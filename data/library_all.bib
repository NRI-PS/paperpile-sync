doi = "10.1111/j.1745-9125.2000.tb00886.x",
language = "en"
}

@ARTICLE{Bernasco2003-EFFECTSOFATTRACTIVENESSOPPORTUNITYANDACCESSIBILITYTOBURGLARSONRESIDENTIALBURGLARYRATESOFURBANNEIGHBORHOODSWIMBERNASCOFLOORLUYKXNetherlandsInstituteForTheStudyOfCrimeAn-..-mg,
title = "EFFECTS OF ATTRACTIVENESS, OPPORTUNITY AND ACCESSIBILITY TO BURGLARS ON RESIDENTIAL BURGLARY RATES OF URBAN NEIGHBORHOODS WIM BERNASCO FLOOR LUYKX`` Netherlands institute for the study of crime and law enforcement (NSCR)",
