@ARTICLE{Rueness2020-AdolescentAbuseVictimsDisplayedPhysicalHealthComplaintsAndTraumaSymptomsDuringPostDisclosureInterviews-..-cq,
title = "Adolescent abuse victims displayed physical health complaints and trauma symptoms during post disclosure interviews",
