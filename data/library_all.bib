@ARTICLE{Stalans1996-FamilyHarmonyOrIndividualProtectionPublicRecommendationsAboutHowPoliceCanHandleDomesticViolenceSituations-..-kh,
title = "Family Harmony or individual protection?: Public recommendations about how police can handle domestic violence situations",
author = "Stalans, Loretta J",
journal = "The American behavioral scientist",
publisher = "SAGE Publications",
volume =  39,
number =  4,
pages = "433-448",
abstract = "Domestic violence situations create tough choices between protecting an individual's safety and fostering family harmony and autonomy. Using a sample of 157 adult residents of Georgia, this study examines how the public wants the police and court to handle domestic violence situations. Respondents read a detailed story about a domestic violence situation and then recommended how the police and court should handle the situation. The majority of respondents wanted the police and the courts to provide referrals to marriage counseling; only 26\% of the respondents recommended arrest when the wife had moderately severe injuries. Respondents based their preference for arrest or informal methods on their fairness and on their effectiveness at reducing conflict. These findings suggest that the public may still place more importance on rehabilitative justice than on retributive justice. Moreover, the public recognizes the victim's need for protection but still places much importance on family autonomy and harmony. Practical implications and future research directions are discussed.",
month =  feb,
