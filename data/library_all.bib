@ARTICLE{Weitzman2018-DoesIncreasingWomensEducationReduceTheirRiskOfIntimatePartnerViolenceEvidenceFromAnEducationPolicyReformCompulsorySchoolingAndIntimatePartnerViolence-..-xy,
title = "Does increasing women's education reduce their risk of intimate partner violence? Evidence from an education policy reform: Compulsory schooling and intimate partner violence",
author = "Weitzman, Abigail",
