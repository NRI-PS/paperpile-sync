@ARTICLE{Reisig2023-MeasuringNormativeObligationToObeyThePoliceAnEmpiricalAssessmentOfANewPoliceLegitimacyScale-..-vd,
title = "Measuring normative obligation to obey the police: An empirical assessment of a new police legitimacy scale",
