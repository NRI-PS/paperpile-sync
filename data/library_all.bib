@ARTICLE{Winter2012-HowNormsCanGenerateConflictAnExperimentOnTheFailureOfCooperativeMicro-motivesOnTheMacro-level-..-ip,
title = "How norms can generate conflict: An experiment on the failure of cooperative micro-motives on the macro-level",
