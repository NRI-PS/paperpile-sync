author = "Garofalo, James",
journal = "The journal of research in crime and delinquency",
publisher = "SAGE Publications",
address = "Thousand Oaks, CA",
volume =  18,
number =  2,
pages = "319-350",
abstract = "The mass media are pervasive in the United States, and accusations about the media's role in eliciting deviant behaviors are common. Yet criminologists have paid scant attention to the media in their theories and research. There is, however, a body of research conducted by psychologists, political scientists, and sociologists that bears, directly or indirectly, on the issues of crime and justice. This article draws on that research in reviewing the major findings on a selected set of topics. In general, the available research shows that crime is a relatively staple topic in the media's news and entertainment presentations. The amount of crime depicted has little relationship to the amount of crime occurring, and violent crimes are high ly overrepresented by the media. The effects of these distorted portrayals on public attitudes and beliefs are unclear because conflicting research results have emerged. On the other hand, the research strongly supports the notion that the viewing of violence increases the probability of behaving aggressively. The review concludes with several broad suggestions for media-related research that would be relevant to issues in criminology and crimincel justice.",
month =  jul,
year =  1981,
url = "https://journals.sagepub.com/doi/full/10.1177/002242788101800207",
file = "All_Papers/30_ReviewE/363_publicity/Garofalo1981_09376.pdf",
