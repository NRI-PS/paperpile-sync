@ARTICLE{Mumford2020-PerpetrationOfAdolescentDatingRelationshipAbuseTheRoleOfConditionalToleranceForViolenceAndFriendshipFactorsTheRoleOfConditionalToleranceForViolenceAndFriendshipFactors-..-gy,
title = "Perpetration of adolescent dating relationship abuse: The role of conditional tolerance for violence and friendship factors: The role of conditional tolerance for violence and friendship factors",
author = "Mumford, Elizabeth A and Taylor, Bruce G and Giordano, Peggy C",
journal = "Journal of interpersonal violence",
