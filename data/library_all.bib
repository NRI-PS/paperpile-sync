file = "All_Papers/30_ReviewE/321_SA実証研究/Wallace1999_41922.pdf",
keywords = "321\_SA実証研究",
doi = "10.3141/1666-16",
language = "en"
}

@ARTICLE{Barnard-Wills2012-E-safetyEducationYoungPeopleSurveillanceAndResponsibility-..-ye,
title = "E-safety education: Young people, surveillance and responsibility",
