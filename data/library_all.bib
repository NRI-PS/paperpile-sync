@ARTICLE{Maddux1983-ProtectionMotivationAndSelf-efficacyARevisedTheoryOfFearAppealsAndAttitudeChange-..-dq,
title = "Protection motivation and self-efficacy: A revised theory of fear appeals and attitude change",
author = "Maddux, James E and Rogers, Ronald W",
