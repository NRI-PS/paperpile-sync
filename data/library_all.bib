keywords = "intimate partner violence (IPV); domestic violence; criminal careers; specialization; prediction; Intimate Partner Violence; Recidivism; Criminal Offenders;320\_ST実証研究;Criminal Justice and Behavior\_●Sage",
doi = "10.1177/0093854816637886",
language = "en"
}

@ARTICLE{Henning2021-PrioritizingPoliceInvestigationsOfIntimatePartnerViolenceUsingActuarialRiskAssessment-..-yp,
