@ARTICLE{Kim2023-EstimatingAge-gradedEffectsOfBusinessesOnCrimeInPlace-..-jv,
title = "Estimating age-graded effects of businesses on crime in place",
author = "Kim, Young-An and Wo, James C and Hipp, John R",
