}

@ARTICLE{Schnobrich-Davis2014-ACaseStudyOfALawEnforcementCouncilEconomyOfScaleAndScopeOrTooCostlyForAgencies-..-qk,
title = "A case study of a law enforcement council: Economy of scale and scope or too costly for agencies?",
author = "Schnobrich-Davis, Julie",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  16,
number =  3,
pages = "189-204",
abstract = "This research fills some gaps in the literature regarding the viability and sustainability of law enforcement councils for policing in the twenty-first century. The Metropolitan Law Enforcement Council (Metro-LEC) is a non-profit organization comprising 43 law enforcement agencies in the Commonwealth of Massachusetts that have pooled resources and regionalized selected police services. The amalgamation provides services to small- and medium-sized police agencies to address incidents that go beyond their capability in scale/duration and in scope/skills. Results are presented from multi-wave surveys of frontline officers as well as surveys administered to the chief executive officers in member police agencies regarding their perceptions of the organization. In addition, a cost analysis presents a comparison between the costs of operating regionalized police units to the costs of operating those units in-house. The overall findings conclude that a law enforcement council approach provides needed services to area police agencies that are valued, utilized, cost effective and sustainable over time.",
month =  "1~" # aug,
