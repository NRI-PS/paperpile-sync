year =  2020,
url = "https://search.ebscohost.com/login.aspx?direct=true&db=psyh&AN=2020-53105-016&authtype=cookie,cpid&custid=s8854603&lang=ja&site=ehost-live",
file = "All_Papers/30_ReviewE/320_ST実証研究/Nesset2020_19891.pdf",
keywords = "Intimate partner violence; arrest; police; structured risk assessment;320\_ST実証研究",
doi = "10.1177/0886260517706762",
language = "en"
}

@ARTICLE{Wathen2018-RelationshipsAmongIntimatePartnerViolenceWorkAndHealth-..-zx,
