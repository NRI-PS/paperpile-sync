language = "en"
}

@ARTICLE{Foster2021-SafeHabitatsDoesTheAssociationBetweenNeighborhoodCrimeAndWalkingDifferByNeighborhoodDisadvantage-..-kp,
title = "Safe habitats: Does the association between neighborhood crime and walking differ by neighborhood disadvantage?",
