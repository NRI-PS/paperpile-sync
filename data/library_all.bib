@ARTICLE{Kuo2012-TheConcentrationOfCriminalVictimizationAndPatternsOfRoutineActivities-..-zk,
title = "The concentration of criminal victimization and patterns of routine activities",
author = "Kuo, Shih-Ya and Cuvelier, Steven J and Sheu, Chuen-Jim and Zhao, Jihong Solomon",
journal = "International journal of offender therapy and comparative criminology",
