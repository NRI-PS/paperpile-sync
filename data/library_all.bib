title = "What influences parents' fear about children's independent mobility? Evidence from a state-wide survey of Australian parents",
author = "Bennetts, Shannon K and Cooklin, Amanda R and Crawford, Sharinne and D'Esposito, Fabrizio and Hackworth, Naomi J and Green, Julie and Matthews, Jan and Strazdins, Lyndall and Zubrick, Stephen R and Nicholson, Jan M",
