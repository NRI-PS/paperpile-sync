@ARTICLE{Farrell2010-ExplainingAndSustainingTheCrimeDropClarifyingTheRoleOfOpportunity-relatedTheories-..-nn,
title = "Explaining and sustaining the crime drop: Clarifying the role of opportunity-related theories",
author = "Farrell, Graham and Tilley, Nick and Tseloni, Andromachi and Mailley, Jen",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  12,
number =  1,
pages = "24-41",
abstract = "Western industrialised countries experienced major reductions in crime for a decade from the early to mid-1990s. The absence of adequate explanation identifies a failing of criminological theory and empirical study. More importantly, it means that none of the forces that reduced crime can confidently be harnessed for policy purposes. Existing hypotheses relating to the crime drops are reviewed and found generally wanting. Many do not stand up to empirical testing. Others do not seem able to explain crime increases (such as phone theft and robbery and internet-related crimes) that occurred alongside the crime drops. It is suggested that the set of opportunity-related theories, or the criminologies of everyday life, present a more promising line of research. The ‘security hypothesis’ is discussed wherein changes in the level and quality of security may have been a key driving force behind the crime drop, and an agenda of crime-specific research is proposed.",
month =  "1~" # feb,
year =  2010,
url = "https://link.springer.com/content/pdf/10.1057/cpcs.2009.20.pdf",
file = "All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/cpcs.2009.20.pdf;All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/cpcs.2009.20.pdf",
