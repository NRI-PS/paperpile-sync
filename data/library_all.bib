@ARTICLE{Farrington2006-HowImportantIsRegressionToTheMeanInArea-basedCrimePreventionResearch-..-hg,
title = "How important is “regression to the mean” in area-based crime prevention research?",
author = "Farrington, David P and Welsh, Brandon C",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  8,
number =  1,
pages = "50-60",
abstract = "If an area with a relatively high crime rate is chosen to receive a crime prevention programme, its crime rate is likely to decrease after the programme because of fluctuations in crimes over time caused by fluctuations in influencing factors. This is called “regression to the mean”. If this high-crime experimental area is compared with a control area with a lower crime rate, crimes are likely to decrease more in the experimental area than in the control area because of these fluctuations, possibly creating the illusion that the programme had an effect when in fact it did not. This article estimates the importance of “regression to the mean” using recorded crime rates in police Basic Command Units (BCUs) in England and Wales in 2002–03 and 2003–04. It is concluded that, in reasonable comparisons between areas with high and moderately high crime rates, this effect may cause a 4\% decrease in crimes. Hence, it could not account for much of the 19\% decrease in crimes following improved street lighting.",
month =  "1~" # feb,
year =  2006,
url = "https://link.springer.com/content/pdf/10.1057/palgrave.cpcs.8150017.pdf",
file = "All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/palgrave.cpcs.8150017.pdf",
keywords = "CPCS1999-2009;CPCS815;Crime Prevention and Community Safety",
doi = "10.1057/palgrave.cpcs.8150017",
language = "en"
}

@ARTICLE{Rowbotham2006-AQuestionOfdisEngagementHistoricalLessonsInPromotingAnEffectivePublicInterfaceToAddressCurrentCrimeConcerns-..-rn,
