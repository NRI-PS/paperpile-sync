@ARTICLE{Zandifar2020-PrevalenceAndSeverityOfDepressionAnxietyStressAndPerceivedStressInHospitalizedPatientsWithCOVID-19-..-ex,
title = "Prevalence and severity of depression, anxiety, stress and perceived stress in hospitalized patients with COVID-19",
author = "Zandifar, Atefeh and Badrfam, Rahim and Yazdani, Shahrooz and Arzaghi, Seyed Masoud and Rahimi, Fatemeh and Ghasemi, Somayeh and Khamisabadi, Somayeh and Mohammadian Khonsari, Nami and Qorbani, Mostafa",
journal = "Journal of diabetes and metabolic disorders",
