@ARTICLE{Kyprianides2020-PlayingTheGamePowerAuthorityAndProceduralJusticeInInteractionsBetweenPoliceAndHomelessPeopleInLondon-..-eu,
title = "‘playing the game’: Power, authority and procedural justice in interactions between police and homeless people in London",
