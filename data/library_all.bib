file = "All_Papers/30_ReviewE/308_STC/Shoesmith2013_18793.pdf",
keywords = "Crime forecasting; Autoregressive models; Disaggregation; Regional forecasting; Time series;308\_STC",
doi = "10.1016/j.ijforecast.2012.08.002",
language = "en"
}

@ARTICLE{Shiode2014-MicroscalePredictionOfNear-futureCrimeConcentrationsWithStreet-levelGeosurveillanceMicroscalePredictionOfNear-futureCrimeConcentrations-..-un,
