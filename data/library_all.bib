@ARTICLE{Barnes2014-MarriageAndInvolvementInCrimeAConsiderationOfReciprocalEffectsInANationallyRepresentativeSample-..-xp,
title = "Marriage and involvement in crime: A consideration of reciprocal effects in a nationally representative sample",
author = "Barnes, J C and Golden, Kristin and Mancini, Christina and Boutwell, Brian B and Beaver, Kevin M and Diamond, Brie",
journal = "Justice quarterly",
publisher = "Informa UK Limited",
