url = "https://onlinelibrary.wiley.com/doi/abs/10.1111/1745-9125.12180",
file = "All_Papers/30_ReviewE/301_ComCrm/BRUNTON-SMITH2018_16253.pdf;All_Papers/30_ReviewE/301_ComCrm/Brunton2018_16253.pdf",
keywords = "collective efficacy; mixed‐effects; location‐scale model; neighborhood effects; multilevel model; consensus effects;301\_ComCrm;criminology",
doi = "10.1111/1745-9125.12180",
language = "en"
}

@ARTICLE{Brennan2023-ViolenceWorryAndTrustInTheEmergenceOfWeapon-carrying-..-zu,
title = "Violence, worry and trust in the emergence of weapon-carrying",
