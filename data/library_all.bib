title = "Intersectionality and gender mainstreaming in international health: using a feminist participatory action research process to analyse voices and debates from the global south and north",
author = "Tolhurst, Rachel and Leach, Beryl and Price, Janet and Robinson, Jude and Ettore, Elizabeth and Scott-Samuel, Alex and Kilonzo, Nduku and Sabuni, Louis P and Robertson, Steve and Kapilashrami, Anuj and Bristow, Katie and Lang, Raymond and Romao, Francelina and Theobald, Sally",
