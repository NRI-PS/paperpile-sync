@ARTICLE{Johnson2001-PrevelanceAndConsequencesOfSpousalAssaultInCanada-..-hm,
title = "Prevelance and consequences of spousal assault in Canada",
author = "Johnson, Holly and Bunge, Valerie Pottie",
journal = "Canadian Journal of Criminology",
publisher = "Canadian Criminal Justice Assn",
volume =  43,
number =  1,
pages = "27-45",
abstract = "Compared the prevalence, consequences, and outcomes of spousal violence experienced by husbands and wives in Canada. 8,450 females and 8,341 males (aged 15+ yrs) completed identically worded questionnaires concerning violent victimization by their marital partners. Results show that 5-yr rates of self-reported spousal violence victimization were 8.7\% for females and 7\% for males. This difference was statistically significant. Higher rates were reported in previous, as opposed to current, unions. The nature and consequences of assaults inflicted on females by their spouses were more severe than spousal assaults against males. Assaults reported by females were more frequent and resulted in more serious consequences for victims and higher costs for society. Female victims were more likely to be injured, to use medical services, spend time in the hospital, to take time off (paid or unpaid) work, to use counselling and shelter services, and to report the violence to the police. Females were 5 times more likely than males to say they feared their lives were in danger from a violent spouse. It is concluded that, although females and males experience a similar degree of spousal violence, consequences, outcomes, and costs are more severe for females. (PsycINFO Database Record (c) 2016 APA, all rights reserved)",
year =  2001,
url = "https://search.ebscohost.com/login.aspx?direct=true&db=psyh&AN=2001-14373-001&authtype=cookie,cpid&custid=s8854603&lang=ja&site=ehost-live",
