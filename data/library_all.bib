@ARTICLE{McAra2007-YouthJusticeTheImpactOfSystemContactOnPatternsOfDesistanceFromOffending-..-xg,
title = "Youth justice?: The impact of system contact on patterns of desistance from offending",
author = "McAra, Lesley and McVie, Susan",
