year =  2024,
url = "http://dx.doi.org/10.1177/08862605231222455",
file = "All_Papers/30_ReviewE/321_SA実証研究/Moylan2024_41880.pdf",
keywords = "campus climate; campus sexual abuse; campus sexual assault; higher education; sexual violence;321\_SA実証研究;CampusCrime",
doi = "10.1177/08862605231222455",
language = "en"
}

