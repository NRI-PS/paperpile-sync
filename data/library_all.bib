@ARTICLE{Sonderskov2022-CrimeVictimizationIncreasesTurnoutEvidenceFromIndividual-levelAdministrativePanelData-..-cj,
title = "Crime victimization increases turnout: Evidence from individual-level administrative panel data",
author = "Sønderskov, Kim Mannemar and Dinesen, Peter Thisted and Finkel, Steven E and Hansen, Kasper M",
journal = "British Journal of Political Science",
publisher = "Cambridge University Press (CUP)",
volume =  52,
number =  1,
pages = "399-407",
abstract = "AbstractWhat are the consequences of being the victim of crime for political participation? Previous studies report mixed results with respect to voter turnout, in contrast to the positive effects found for other indicators of political engagement. However, previous turnout studies have failed to differentiate between violent and non-violent crime, and have relied on cross-sectional survey data that is prone to measurement biases and selection effects. This article addresses these shortcomings via a panel analysis of official registry data from Denmark recording individual-level turnout in two municipal elections (in 2009 and 2013) and victimization from violent and non-violent crime. It identifies the effect of victimization by comparing changes in turnout between the two elections for victims and two different counterfactual groups: non-victims in the general population, and individuals who were victimized after the 2013 election. The results show that victimization from violent crime increases turnout by 2 to 3 percentage points. The study further demonstrates a large negative between-individual effect of victimization, suggesting that previous studies have been marred by severe selection bias.",
month =  jan,
year =  2022,
url = "http://dx.doi.org/10.1017/S0007123420000162",
doi = "10.1017/s0007123420000162",
language = "en"
}

@ARTICLE{Fienberg1980-TheMeasurementOfCrimeVictimizationProspectsForPanelAnalysisOfAPanelSurvey-..-aw,
title = "The measurement of crime victimization: Prospects for panel analysis of a panel survey",
author = "Fienberg, S E",
journal = "The Statistician: Journal of the Institute of Statisticians",
publisher = "JSTOR",
volume =  29,
number =  4,
pages =  313,
abstract = "``Crime is up !'' In the United States, from 1960 to 1975 the Federal Bureau of Investigation(FBI)throughitsUniformCrimeReporting(UCR)Programme reported to the public that the offence rates for seven crimes (murder, rape, robbery, aggravated assault, burglary, larceny, and motor vehicle theft) continued to rise, often dramatically so. Public reaction to such reports was predictably reflected in public opinion poll results showing that in excess of 40 per cent of respondents were ``afraid to walk alone at night'', almost 70 per cent felt that ``too little was being spent to halt the rising crime rate'', and over 70 per cent favoured mandatory gun permits (US Department of Commerce, 1977). While some people experience criminal acts as part of their day-to-day life, the fact remains that in the life of a typical American crimes are relatively rare events. Thus it might be reasonable to conclude that the rises in the FBI's UCR crime rates were responsible for much of the public's heightened fear of crime. But the UCR rates are for crimes reported to the police, and a large proportion of crimes are never officially reported. The result is the ``dark figure of crime''. This and other limitations of police crime statistics have been viewed by many as being so great as to make it virtually impossible to measure changes in the criminality of the population Thus researchers and government officials have turned to other means of assessing the extent of crime and ``bringing more of the dark figure of crime to statistical light''.",
month =  dec,
year =  1980,
url = "https://dx.doi.org/10.2307/2987732",
doi = "10.2307/2987732"
}

@ARTICLE{Mahuteau2016-CrimeVictimisationAndSubjectiveWell-beingPanelEvidenceFromAustraliaCrimeVictimisationAndSubjectiveWell-being-..-ac,
title = "Crime victimisation and subjective well-being: Panel evidence from Australia: Crime victimisation and subjective well-being",
author = "Mahuteau, Stéphane and Zhu, Rong",
journal = "Health Economics",
publisher = "Wiley",
volume =  25,
number =  11,
pages = "1448-1463",
abstract = "This paper estimates the effect of physical violence and property crimes on subjective well-being in Australia. Our methodology improves on previous contributions by (i) controlling for the endogeneity of victimisation and (ii) analysing the heterogeneous effect of victimisation along the whole distribution of well-being. Using fixed effects panel estimation, we find that both types of crimes reduce reported well-being to a large extent, with physical violence exerting a larger average effect than property crimes. Furthermore, using recently developed panel data quantile regression model with fixed effects, we show that the negative effects of both crimes are highly heterogeneous, with a monotonic decrease over the distribution of subjective well-being. Copyright © 2015 John Wiley \& Sons, Ltd.",
