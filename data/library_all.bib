file = "All_Papers/30_ReviewE/308_STC/Carbone-Lopez2013_11280.pdf",
keywords = "Seasonality; Violent victimization; National Crime Victimization Survey; Youth violence;308\_STC",
doi = "10.1007/s10940-012-9184-8",
language = "en"
}

@ARTICLE{Carter2021-ExaminingTheImmediateEffectsOfCOVID-19OnResidentialAndCommercialBurglariesInMichiganAnInterruptedTime-seriesAnalysis-..-aj,
title = "Examining the immediate effects of COVID-19 on residential and commercial burglaries in Michigan: An interrupted time-series analysis",
author = "Carter, Travis M and Turner, Noah D",
journal = "Journal of criminal justice",
publisher = "Elsevier BV",
address = "United States",
volume =  76,
number =  101834,
pages =  101834,
abstract = "Purpose: Research assessing the relationship between COVID-19 lockdown restrictions and crime is growing. Attention to the nuances of burglary and intra-state variation in lockdown restrictions has received less attention. The current study contributes to this ongoing body of research by investigating the relationship between COVID-19 lockdown restrictions and burglary across four cities in Michigan. Method: We use an interrupted time-series design to analyze weekly counts of residential and non-residential burglary from 2018 to 2020 in four Michigan cities: Detroit, Grand Rapids, Kalamazoo, and Lansing. Results: Findings demonstrate that the relationship between the lockdown and weekly counts of burglary vary by the type of burglary and the city being analyzed. Residential burglaries in half of the sampled cities declined during the Michigan lockdown order. Commercial burglaries increased during the lockdown order in only one of the four cities examined. Conclusions: City-wide crime trends following lockdown orders during the pandemic are not shared equally and vary according to the type of burglary under examination. In studying the effects of COVID-19 on crime, researchers should account for crime- and city-specific dynamics which may influence crime trends. Further, practitioners and policymakers should consider the impact of similar lockdown orders on burglary trends during public health emergencies.",
month =  sep,
year =  2021,
url = "https://dx.doi.org/10.1016/j.jcrimjus.2021.101834",
file = "All_Papers/30_ReviewE/308_STC/Carter2021_19340.pdf",
keywords = "Burglary; COVID-19; Quasi-experimental design; Routine activities;308\_STC;J Crim Justice",
doi = "10.1016/j.jcrimjus.2021.101834",
language = "en"
}

@ARTICLE{Chen2020-ExploringTheHomogeneityOfTheftOffendersInSpatio-temporalCrimeHotspots-..-jv,
title = "Exploring the homogeneity of theft offenders in spatio-temporal crime hotspots",
author = "Chen, Tongxin and Bowers, Kate and Cheng, Tao and Zhang, Yang and Chen, Peng",
journal = "Crime science",
publisher = "Springer Science and Business Media LLC",
address = "Berlin/Heidelberg",
volume =  9,
number =  1,
pages = "1-13",
abstract = "AbstractOffender homogeneity occurs when the same criminal group is composed of offenders with similar attributes (e.g., socio-economic-demographics). Exploring the homogeneity of offenders within spatio-temporal crime hotspots (STCHs) is useful for understanding not only the generational mechanisms of crime hotspots, but also has crime prevention implications. However, the homogeneity of offenders within STCHs has not been explored in criminological studies hitherto. Indeed, current techniques of STCH detection are limited to using statistical clustering methods in existing studies that lack the ability to identify the shape of STCHs or the distribution and variety of offences/offender activity with them. In this study, we utilise a spatio-temporal clustering algorithm called ST-DBSCAN to determine STCHs. We then propose novel entropy-based indices that measure the similarity of offenders (and offences) within STCHs. The method is demonstrated using theft crime records in the central area of Beijing, China. The results show that theft in the city is concentrated in a narrow space and time span (STCHs) and that within these associated offenders with similar social demographics, referred to as homogeneous offender groups are detectable.",
month =  dec,
year =  2020,
url = "https://link.springer.com/article/10.1186/s40163-020-00115-8",
file = "All_Papers/30_ReviewE/308_STC/Chen2020_17426.pdf",
keywords = "308\_STC",
doi = "10.1186/s40163-020-00115-8",
language = "en"
}

@ARTICLE{Chen2013-Space-timeAnalysisOfBurglaryInBeijing-..-oi,
title = "Space-time analysis of burglary in Beijing",
author = "Chen, Peng and Yuan, Hongyong and Li, Dengsheng",
journal = "Security journal",
