author = "Feinberg, Gary",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  11,
number =  4,
pages = "277-296",
abstract = "This study explores the nature, magnitude and seriousness of ‘unofficial fees’ and other forms of corruption in Cambodia, a nation still reeling from the devastating effects of Pol Pot's genocidal regime (1975–1979), one that annihilated its intellectual resources, destroyed its economy and eviscerated its social identity. It continues by profiling unofficial fees and corruption in education, health care and other public agencies and ‘job renting,’ as well as a mammoth tax-evasion problem. In addition, perceived causes of corruption and its manifold and pernicious consequences are addressed. It concludes with a critical analysis of proffered methods for reducing corruption, such as implementing an independent judiciary, improving public officials’ salaries, applying transparent accounting procedures and other collaborative solutions.",
