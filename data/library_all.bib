doi = "10.1177/0260107919897219",
language = "en"
}

@ARTICLE{Gangl2022-ImplicitRemindersOfReputationAndNatureReduceLitteringMoreThanExplicitInformationOnInjunctiveNormsAndMonetaryCosts-..-md,
title = "Implicit reminders of reputation and nature reduce littering more than explicit information on injunctive norms and monetary costs",
author = "Gangl, K and Walter, A and Van Lange, P A M",
journal = "Journal of environmental psychology",
publisher = "Elsevier BV",
volume =  84,
number =  101914,
pages =  101914,
abstract = "The present research addresses tools that could help reduce littering in society. Four interventions were tested which, based on different processes, should reduce littering: monetary information, the depicted injunctive norm, watching eyes and a nature picture. To test these interventions, a randomized controlled trial (RCT) involving 440 community building's waste disposal areas (N = 71,155) was conducted in Vienna. Littering was assessed before the intervention, 24–48 h after, and again seven weeks after the intervention. Results show that the financial intervention (monetary information) hardly had any effect on littering whereas the norm-based intervention (depicted injunctive norm) led to more littering compared to the control and in particular, the nature picture. In contrast, the reputation-based intervention (watching eyes) and ecology-based intervention (nature picture) reduced littering over time by 4.7\%. Thus, interventions based on implicit and soft appeals to reputation and ecology are more effective in fostering clean environments than classical interventions applying explicit information on finances and norms.",
month =  dec,
year =  2022,
