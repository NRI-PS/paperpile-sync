file = "All_Papers/Published_Journal/J_TF1505/Moriarty2008_12736.pdf",
keywords = "J\_TF1505;Victims \& Offenders",
doi = "10.1080/15564880802143363",
language = "en"
}

@ARTICLE{Moriarty2008-CyberstalkingUtilizingNewspaperAccountsToEstablishVictimizationPatterns-..-gk,
