}

@ARTICLE{Zeelenberg1998-TheExperienceOfRegretAndDisappointment-..-mt,
title = "The experience of regret and disappointment",
author = "Zeelenberg, Marcel and van Dijk, Wilco W and S.R.Manstead, Antony and der Pligt, Joopvan",
