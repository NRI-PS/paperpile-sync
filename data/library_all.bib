keywords = "sexual dating violence; risk factors; victimization; adolescence attitudes; Human; Male; Female; Childhood (birth-12 yrs); School Age (6-12 yrs); Adolescence (13-17 yrs); Empirical Study; Followup Study; longitudinal analysis; Quantitative Study; Social Dating; Violence; Adolescent Attitudes; US; 3230:Behavior Disorders \& Antisocial Behavior;320\_ST実証研究",
doi = "10.1016/j.ypmed.2004.04.014",
language = "en"
}

@ARTICLE{Fleury-Steiner2006-ContextualFactorsImpactingBatteredWomensIntentionsToReuseTheCriminalLegalSystem-..-ew,
title = "Contextual factors impacting battered women's intentions to reuse the criminal legal system",
author = "Fleury-Steiner, Ruth E and Bybee, Deborah and Sullivan, Cris M and Belknap, Joanne and Melton, Heather C",
journal = "Journal of community psychology",
publisher = "Wiley",
volume =  34,
number =  3,
pages = "327-342",
abstract = "While a small number of past studies have examined either situational, relational, or systems-level factors that influence battered women's use of either the police, prosecutorial, or court systems, no study to date has examined how these factors each influence women's intentions to reuse these systems. To address this gap, in-person interviews were conducted with 178 women whose assailants had been charged with a domestic violence-related crime against them. Survivors of intimate partner violence were asked about the violence itself, their relationship with the perpetrator (including financial dependence on him), community supports, their expectations, and desires regarding the criminal legal response, and their prior experiences with the police, prosecutors, legal advocates, and the courts. Regression analyses were conducted to examine women's intentions to reuse the criminal legal system in the event of future violence. Consistent with an ecological perspective on behavior (e.g., Bronfenbrenner, 1979), the context of women's lives, the violence they had experienced, and their experiences with the police and the legal system all impacted their intentions. Specifically, women were more likely to want further involvement with these systems if they were employed, felt supported by their communities, had received information about services from the police, had experienced case outcomes consistent with their desires, and had been treated well by the criminal legal system. Women were less inclined to intend to use the system in the future if they were legally or financially tied to their perpetrators, if they had been assaulted again before the court case was closed, if court proceedings had been cancelled at least once, and if they had been pressured rather than supported by the criminal legal system. Implications of the findings are discussed. (PsycInfo Database Record (c) 2020 APA, all rights reserved)",
month =  "1~" # may,
year =  2006,
url = "https://search.ebscohost.com/login.aspx?direct=true&db=psyh&AN=2006-04903-006&authtype=cookie,cpid&custid=s8854603&lang=ja&site=ehost-live",
file = "All_Papers/30_ReviewE/320_ST実証研究/Fleury-Steiner2006_19982.pdf",
keywords = "situational factors; relational factors; systems-level factors; domestic violence; relationship with perpetrator; community supports; intent to reuse criminal legal system; battered women; Battered Females; Criminal Justice; Intention; Interpersonal Relationships; Adjudication; Criminal Behavior; Intimate Partner Violence;320\_ST実証研究",
doi = "10.1002/jcop.20102",
language = "en"
}

