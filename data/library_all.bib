@ARTICLE{Tyler1988-WhatIsProceduralJusticeCriteriaUsedByCitizensToAssessTheFairnessOfLegalProcedures-..-er,
title = "What is procedural justice?: Criteria used by citizens to assess the fairness of legal procedures",
author = "Tyler, Tom R",
journal = "Law \& society review",
