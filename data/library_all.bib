@ARTICLE{Weber1985-ManagingALow-incidenceRiskTheExampleOfToxicShockSyndrome-..-jo,
title = "Managing a low-incidence risk: the example of toxic shock syndrome",
author = "Weber, E U",
journal = "Risk analysis: an official publication of the Society for Risk Analysis",
