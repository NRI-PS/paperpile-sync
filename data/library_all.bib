}

@ARTICLE{Farmer2022-CorrectionToPatronBanningPolicyAndPracticeInQueenslandAustraliaKeyInformantPerspectives-..-cl,
title = "Correction to: Patron banning policy and practice in Queensland, Australia: key informant perspectives",
author = "Farmer, Clare and Miller, Peter and Robertson, Narelle and Ferris, Jason and Taylor, Nicholas and Coomber, Kerri and Curtis, Ashlee and de Andrade, Dominique",
