title = "Community-based vigilante violence and corporate social responsibility in Nigeria’s oil-producing region",
author = "Uduji, Joseph Ikechukwu and Okolo-Obasi, Elda Nduka and Aja, Damian Uche and Otei, Deborah Chinwendu and Obi-Anike, Happiness Ozioma and Ezuka, Samuel Chukwuemeka and Nwanmuoh, Emmanuel Ejiofo and Emengini, Steve Emeka",
