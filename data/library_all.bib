@ARTICLE{Hewitt2020-OffenderAndVictimJourney-to-crimeMotivationalDifferencesAmongStrangerRapists-..-zt,
title = "Offender and victim ‘journey-to-crime’: Motivational differences among stranger rapists",
author = "Hewitt, Ashley N and Chopin, Julien and Beauregard, Eric",
journal = "Journal of criminal justice",
publisher = "Elsevier BV",
address = "New York",
volume =  69,
number =  101707,
pages =  101707,
abstract = "To examine the variability in the ‘journey-to-crime’ and ‘journey-to-victimization’ in stranger rapes when disaggregated by offender motive. Using crime pattern theory as the theoretical framework, a series of pre-offense factors are used to explain these differences. Two-step cluster analysis is first used to identify motive subtypes in 1009 stranger female rapes from a French police database. Kruskal-Wallis analyses then test for significant differences in distances traveled between the motivational groups. Finally, a series of negative binomial regressions are conducted to predict three distance measures: offender's residence to crime scene, victim's residence to crime scene, and victim's residence to offender's residence. The average distances traveled for both offenders and victims to the crime scene, and between their residences, varied by motive. Findings from the regression models indicated that while offender motive is important, environmental characteristics and victim activity at the time of the assault also predict the distances traveled for both individuals. Determining the most likely motive of the offender, in conjunction with other offense characteristics that would be known at the time of investigation, has the potential to provide law enforcement officials with an indication of the unknown offender's geographic behavior in active rape cases. •It is possible to deduce an unknown offender's motive through crime scene behavior•Distance traveled by offenders and victims differs by motive to offend•Offender motivation is the strongest predictor of offender journey-to-crime•Environmental factors most strongly predict the journey-to-victimization•Environmental factors best explain the distance between victim and offender residences",
month =  "1~" # jul,
year =  2020,
url = "https://dx.doi.org/10.1016/j.jcrimjus.2020.101707",
file = "All_Papers/30_ReviewE/330_SAEnv/Hewitt2020_17443.pdf",
keywords = "Investigation; Journey-to-crime; Journey-to-victimization; Offender motivation; Rape;330\_SAEnv;J Crim Justice;Journey to crime/victimization",
doi = "10.1016/j.jcrimjus.2020.101707",
language = "en"
}

