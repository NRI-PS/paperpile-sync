@ARTICLE{Lee1997-ExplainingKoreanWomensFearOfCrime-..-lj,
title = "Explaining Korean women's fear of crime",
author = "Lee, Yoon Ho",
journal = "International journal of comparative and applied criminal justice",
publisher = "Informa UK Limited",
address = "Wichita, Kan",
volume =  21,
number =  2,
pages = "317-329",
abstract = "This study is intended to explain the fear of crime among Korean women. Due to the complexity of concept and measurement of fear, this study was designed to measure specific or concrete fear and general or formless fear. Data were obtained from a self‐administered survey to 528 Korean women living in the city of Seoul, Korea. The results revealed that the fear of crime seems to be experienced differently. That is, specific fear appears to be most influenced by their knowledge of the occurrence of crime, followed by community environment and their perceptions about the incidence of crime, while the general fear of crime seems to be explained only by their perceptions about the incidence of crime at the significance level of p<.05.",
