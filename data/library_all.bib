}

@ARTICLE{Beech2009-AssessingFemaleSexualOffendersMotivationsAndCognitionsAnExploratoryStudy-..-fe,
title = "Assessing female sexual offenders’ motivations and cognitions: an exploratory study",
author = "Beech, Anthony R and Parrett, Natalie and Ward, Tony and Fisher, Dawn",
journal = "Psychology, crime \& law: PC \& L",
publisher = "Informa UK Limited",
volume =  15,
number = "2-3",
pages = "201-216",
abstract = "Abstract Semi-structured interviews eliciting cognitions and motivations were carried out with 15 incarcerated female child sexual abusers (nearly 50\% of the current UK female sexual offender prison population). Qualitative analysis indicated that four of the five motivational schemas (implicit theories) suggested by Ward (Ward, 2000; Ward \& Keenan, 1999) to underlie male sexual offenders’ cognitions could be clearly identified in women, these were: Uncontrollability (UN, identified in 87\% of participants), Dangerous world (DW, 53\%), Children as sexual objects (CSO, 47\%) and Nature of harm (NH, 20\%). Entitlement, the final implicit theory (IT), commonly found in males, was not identified in any participants in the sample. Further analysis indicated that there were four main motivational types of offender based on combinations of these ITs. These were: (1) presence of DW/CSO, indicating sexual motivation and cognitions with fear of violence; (2) presence of DW/no CSO, indicating fear of violence with no sexual cognition or motivation; (3) presence of CSO/no DW, indicating sexual motivation and cognition; the NH IT also strongly featured in this group; and (4) presence of UN/no DW or CSO, indicating lack of control, sometimes with sense of protection for the victim. Suggestions are made on how the results can inform theoretical developments in the field as well as policy and practice.",
month =  feb,
year =  2009,
url = "http://dx.doi.org/10.1080/10683160802190921",
file = "All_Papers/Published_Journal/J_TF1505/Beech2009_12606.pdf",
keywords = "J\_TF1505",
doi = "10.1080/10683160802190921"
}

@INCOLLECTION{Bennett1984-ConstraintsToBurglary-TheOffendersPersepective-..-tg,
