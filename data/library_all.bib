@ARTICLE{Pickett2018-UsingBehavioralEconomicsToAdvanceDeterrenceResearchAndImproveCrimePolicySomeIllustrativeExperiments-..-jn,
title = "Using behavioral economics to advance deterrence research and improve crime policy: Some illustrative experiments",
author = "Pickett, Justin T",
journal = "Crime and delinquency",
