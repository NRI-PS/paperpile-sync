language = "en"
}

@ARTICLE{Meyer2010-TheRelationshipBetweenBatteredWomensCausalAttributionsForViolenceAndCopingEfforts-..-kj,
title = "The relationship between battered women's causal attributions for violence and coping efforts",
author = "Meyer, Alicia and Wagner, Barry and Dutton, Mary Ann",
journal = "Journal of interpersonal violence",
