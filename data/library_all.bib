number =  1,
pages = "1-15",
abstract = "Crime prevention through environmental design (CPTED) guidelines have been adopted in Australia and internationally. In 2001 CPTED guidelines were introduced in New South Wales (NSW). Since their introduction there has been little discussion or scholarly analysis of these guidelines. This article seeks to address this gap through a critical analysis of the NSW guidelines and related crime risk assessment reports. On the basis of this analysis, we argue that the guidelines provide limited direction for the compilation of crime risk assessment reports and little guidance to local authorities (that is councils) assessing development applications. The existing guidelines are based on four CPTED concepts, which limits assessment of crime risks and the lack of diagrams, photos or illustrations reduces their overall utility. While the introduction of the guidelines triggered an increased focus on ways to design out crime, our research suggests the guidelines require revision. Guidelines from other Australian jurisdictions (such as Victoria) provide a potential model for how the NSW guidelines could be improved.",
month =  "1~" # feb,
year =  2012,
url = "https://link.springer.com/content/pdf/10.1057/cpcs.2011.10.pdf",
file = "All_Papers/50_Journal_E/Crime_Prevention_and_Community_Safety/CPCS1999-2009/cpcs.2011.10.pdf",
keywords = "CPCS1999-2009;CPCS2008-2016;Crime Prevention and Community Safety",
doi = "10.1057/cpcs.2011.10",
language = "en"
}

@ARTICLE{Brown2012-WhenInterventionIsALoadOfRubbishEvaluatingTheImpactOfClean-upOperations-..-fk,
title = "When intervention is a load of rubbish: Evaluating the impact of ‘clean-up’ operations",
author = "Brown, Rick and Evans, Emily",
journal = "Crime prevention and community safety",
publisher = "Springer Science and Business Media LLC",
volume =  14,
number =  1,
pages = "33-47",
abstract = "This article examines the impact of 10 clean-up operations designed to improve the environment. The findings of environmental visual audits undertaken before and after the operations show that the level of refuse declines in only half the cases, with an increase in the other half of cases. This may be explained by the poor engagement with the community that can accompany such operations. These findings show that even the simplest, most ‘common-sense’ interventions can bring about unintended consequences without careful thought to the way in which the intervention is expected to work.",
