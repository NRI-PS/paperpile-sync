@ARTICLE{Ison2023-YoureJustConstantlyOnAlertWomenAndGender-DiversePeoplesExperiencesOfSexualViolenceOnPublicTransport-..-am,
title = "``You're just constantly on alert'': Women and Gender-Diverse People's Experiences of Sexual Violence on Public Transport",
author = "Ison, Jessica and Forsdike, Kirsty and Henry, Nicola and Hooker, Leesa and Taft, Angela",
