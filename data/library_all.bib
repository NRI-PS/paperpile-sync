file = "All_Papers/30_ReviewE/320_ST実証研究/Li2009_17031.pdf",
keywords = "320\_ST実証研究",
doi = "10.2105/AJPH.2008.151159",
language = "en"
}

@ARTICLE{Logan2017-StalkingAMultidimensionalFrameworkForAssessmentAndSafetyPlanningAMultidimensionalFrameworkForAssessmentAndSafetyPlanning-..-do,
title = "Stalking: A multidimensional framework for assessment and safety planning: A multidimensional framework for assessment and safety planning",
