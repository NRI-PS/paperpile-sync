@ARTICLE{Chen2022-GoldSilverAndBronzeMeasuringTheImpactOfTheBeijing2008London2012AndRioDeJaneiro2016OlympicsOnCrime-..-ip,
title = "Gold, silver, and bronze: Measuring the impact of the Beijing 2008, London 2012, and Rio de Janeiro 2016 Olympics on crime",
author = "Chen, Yongqi and Riddell, Jordan R and Hill, Joshua B and Chen, Peng and Piquero, Alex R and Kurland, Justin",
