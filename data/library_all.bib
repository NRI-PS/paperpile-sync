@ARTICLE{Hilton2015-TheStep-fatherEffectInChildAbuseComparingDiscriminativeParentalSolicitudeAndAntisociality-..-tg,
title = "The step-father effect in child abuse: Comparing discriminative parental solicitude and antisociality",
author = "Hilton, N Zoe and Harris, Grant T and Rice, Marnie E",
journal = "Psychology of violence",
publisher = "American Psychological Association (APA)",
volume =  5,
number =  1,
pages = "8-15",
abstract = "Objective: The greater risk of abusing a step-child than a genetically related child has been attributed to discriminative parental solicitude. We tested whether it is better explained by antisociality, whereby more antisocial fathers are more likely both to have step-children and to be generally more violent. Method: We studied police reports of assaults on children by 387 domestically violent men who had a minor child, and their bivariate association with genetic relatedness, offender antisociality, and opportunity to assault step-children. In the subsample of 118 men with the opportunity to assault both step and genetically related children, we tested whether fathers were more likely to assault step-children, overall and among more antisocial men. Results: Number of step-children was associated with both child abuse and 2 of 3 measures of antisociality. When opportunity was controlled, fathers showed evidence of discriminative parental solicitude, being twice as likely to assault step-children as genetically related children. This step-father effect was observed at all levels of antisociality. Conclusion: Antisociality alone cannot explain the step-father effect. Discriminative parental solicitude remains a viable explanation for the step-father effect observed in this study. Research is needed to explore more proximal causes of the step-father effect. (PsycINFO Database Record (c) 2016 APA, all rights reserved)",
month =  jan,
year =  2015,
url = "https://search.ebscohost.com/login.aspx?direct=true&db=psyh&AN=2014-12074-001&authtype=cookie,cpid&custid=s8854603&lang=ja&site=ehost-live",
file = "All_Papers/30_ReviewE/320_ST実証研究/Hilton2015_20002.pdf",
keywords = "antisociality; step-father; child abuse; domestic violence; intimate partner violence; Fathers; Stepchildren; Stepparents; Antisocial Behavior; Biological Family;320\_ST実証研究",
doi = "10.1037/a0035189",
language = "en"
}

@ARTICLE{Hilton2016-Non-specializationOfCriminalCareersAmongIntimatePartnerViolenceOffenders-..-yg,
title = "Non-specialization of criminal careers among intimate partner violence offenders",
author = "Hilton, N Zoe and Eke, Angela Wyatt",
journal = "Criminal justice and behavior",
