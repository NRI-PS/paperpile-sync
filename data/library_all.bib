@ARTICLE{vanSleeuwen2018-ATimeForACrimeTemporalAspectsOfRepeatOffendersCrimeLocationChoices-..-ew,
title = "A time for a crime: Temporal aspects of repeat offenders’ crime location choices",
author = "van Sleeuwen, Sabine E M and Ruiter, Stijn and Menting, Barbara",
