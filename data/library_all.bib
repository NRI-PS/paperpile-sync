@ARTICLE{Salloum2011-ImpactOfExposureToCommunityViolenceHurricaneKatrinaAndHurricaneGustavOnPosttraumaticStressAndDepressiveSymptomsAmongSchoolAgeChildren-..-yy,
title = "Impact of exposure to community violence, Hurricane Katrina, and Hurricane Gustav on posttraumatic stress and depressive symptoms among school age children",
