@ARTICLE{terHuurne2009-HowToTrustTheImportanceOfSelf-efficacyAndSocialTrustInPublicResponsesToIndustrialRisks-..-ae,
title = "How to trust? The importance of self‐efficacy and social trust in public responses to industrial risks",
author = "ter Huurne, Ellen F J and Gutteling, Jan M",
