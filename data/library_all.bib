@ARTICLE{Hamby2016-WhatDifferenceDoBystandersMakeTheAssociationOfBystanderInvolvementWithVictimOutcomesInACommunitySample-..-kq,
title = "What difference do bystanders make? The association of bystander involvement with victim outcomes in a community sample",
author = "Hamby, Sherry and Weber, Marcela C and Grych, John and Banyard, Victoria",
journal = "Psychology of violence",
publisher = "American Psychological Association (APA)",
address = "US",
volume =  6,
number =  1,
pages = "91-102",
abstract = "Objective: To fill gaps in the bystander literature by describing patterns of bystander involvement and associations between bystander involvement and victim outcomes across different types of emotional, physical, and sexual victimizations and to expand these considerations to a rural rather than urban sample. Method: Adults and adolescents (n = 1,703) were surveyed about bystander actions, bystander safety, and victim outcomes (injury, disrupted routine, fear level, and current mental health) for 10 forms of victimization. Results: Bystanders were present for roughly 2 thirds of most victimization types (59\% to 67\%), except sexual victimization (17\%). Relatives were the most common bystanders of family violence and friends or acquaintances were the most common bystanders of peer violence. For all 10 victimizations, more bystanders helped than harmed the situation, but most commonly had no impact. Rates of bystander harm for sexual victimizations were higher than for other types. Especially for peer-perpetrated incidents, victim outcomes were often better when bystanders helped. Bystander safety (unharmed and unthreatened) was consistently associated with better victim outcomes. Conclusion: Bystanders witness the majority of physical and psychological victimizations. These data lend support to the premise of many prevention programs that helpful bystanders are associated with more positive victim outcomes. Bystander prevention should focus on the type of bystanders most commonly present and should teach bystanders ways to stay safe while helping victims. (PsycInfo Database Record (c) 2020 APA, all rights reserved)",
month =  jan,
year =  2016,
url = "http://dx.doi.org/10.1037/a0039073",
file = "All_Papers/30_ReviewE/321_SA実証研究/Hamby2016_41335.pdf",
keywords = "*Bystander Effect; *Domestic Violence; *Victimization; Bullying; Emotions; Involvement; Physical Abuse; Sex Offenses; Witnesses;321\_SA実証研究",
doi = "10.1037/a0039073",
language = "en"
}

@PHDTHESIS{Gennari2021-EngagingBystandersToPreventSexualHarassmentInPublicTransportationLearningsFromAnInterventionInMexicoCity-..-gs,
title = "Engaging Bystanders to Prevent Sexual Harassment in Public Transportation: Learnings from an Intervention in Mexico City",
author = "Gennari, Floriza Freire",
editor = "Rimal, Rajiv N",
publisher = "ProQuest Dissertations \& Theses",
address = "United States -- District of Columbia",
abstract = "The sexual harassment (SH) of women in public transportation is a widespread issue, yet research is sparse on how to prevent this type of violence from occurring. In three papers, this dissertation evaluates the impact of the Hazme el Paro! project, a quasi-experimental study that employed a bystander intervention approach to encourage witnesses to intervene in incidents of SH. The study was conducted in Mexico City, Mexico from 2014 to 2016. Papers 1 and 2 are exploratory studies of the psychosocial variables associated with perceived risk of SH and bystander willingness to intervene, while Paper 3 examines the effect of the Hazme el Paro! intervention.Paper 1 explored the correlates of SH risk perception, and the extent to which psychosocial variables moderated the relationship between experiencing or witnessing SH and the perceived risk of being sexually harassed. Among women, results suggest a positive association between risk perception and a) acceptance of SH norms as pervasive, b) the belief that most women disapprove of SH (injunctive norms), and c) witnessing or experiencing SH. The results indicate that risk perception is higher for women with a history of SH when victim-blaming beliefs are present. Among men, injunctive norms were negatively associated with risk perception. The findings suggest campaigns seeking to reduce SH in public transport should consider the role of risk perception antecedents in the framing of messages intending to motivate bystanders to action.Paper 2 then seeks to examine the extent to which risk perception, along with other barriers and facilitators, affected willingness to intervene. As hypothesized, scoring high on self-efficacy to intervene attenuated the negative relationship between holding victim-blaming beliefs and the intention to help a victim of SH. Similarly, those with greater outcome expectations scored higher on willingness to intervene, despite their strong victim-blaming beliefs, than those who reported low outcome expectations. The findings suggest that promoting self-efficacy and outcome expectations may be a viable strategy for increasing bystander intention to intervene, specifically among those with stronger victim-blaming beliefs – the group least likely to express a desire to intervene.Paper 3 documents the extent to which the intervention mattered in significantly improving willingness to intervene and actual intervening behaviors. When examining the overall impact of the intervention bus route and controlling for changes in the comparison bus route as per the difference-in-difference method, the analyses showed statistical significance with the intervention being effective in increasing willingness to intervene at end-line. Based on end-line data only, male respondents in the intervention bus route were more likely to report prosocial bystander behaviors. Findings indicate a dose response effect; greater exposure to the intervention was associated with increased willingness to intervene (among men only) and bystander behavior. Paper 3 also sought to examine the pathway of influence of the intervention; results suggest outcome expectations and victim-blaming were pathways for both men and women.Overall, the findings from this dissertation suggest that a low-resource bystander intervention initiative in public transportation can indeed influence the intention of bystanders to step in and interrupt an incident of SH.",
year =  2021,
url = "https://media.proquest.com/media/hms/PFT/2/5qqmI?_%2BgIBWYIDA1dlYooDHENJRDoyMDIzMDUyNjA4MjgzODQyOTo4MjM5Mzk%3D&_s=mWJjULIZ1lkxGsdFWdZ7%2BexCzVg%3D",
file = "All_Papers/30_ReviewE/321_SA実証研究/Gennari2021_41334.pdf",
keywords = "0344:Social research; 0453:Womens studies; 0709:Transportation; Bystander intervention; Mexico City Mexico; Psychosocial factors; Public transportation; Sexual Harassment; Social research; Transportation; Victim-blaming; Violence against women; Womens studies;321\_SA実証研究;327;330\_SAEnv",
school = "The George Washington University",
language = "en"
}

