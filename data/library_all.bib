title = "Tweeting the spill: Online informal communications, social networks, and conversational microstructures during the Deepwater Horizon oilspill",
author = "Sutton, Jeannette and Spiro, Emma and Butts, Carter and Fitzhugh, Sean and Johnson, Britta and Greczek, Matt",
