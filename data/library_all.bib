@ARTICLE{Cusick2005-TrappingInDrugUseAndSexWorkCareers-..-ij,
title = "‘Trapping’ in drug use and sex work careers",
author = "Cusick, Linda and Hickman, Matthew",
journal = "Drugs (Abingdon, England)",
