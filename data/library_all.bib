keywords = "SOCIAL groups; CRIME; SOCIAL conflict; GENDER; NEIGHBORHOOD;301\_1;13\_Seattle;author\_Wilcox;10\_英語の研究;301\_ComCrm;criminology",
doi = "10.1111/j.1745-9125.1999.tb00505.x",
language = "en"
}

