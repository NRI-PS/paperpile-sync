@ARTICLE{Tiby2009-Stranger-dangerOrFearOfTheNearAccountsOnFearOfSexualAbuse-..-pn,
title = "Stranger-danger or fear of the near? Accounts on fear of sexual abuse",
author = "Tiby, Eva",
journal = "Journal of Scandinavian studies in criminology and crime prevention",
publisher = "Scandinavian University Press / Universitetsforlaget AS",
address = "Basingstoke",
volume =  10,
number =  2,
pages = "144-160",
abstract = "When young persons, aged 16-18, had the possibility to write in their own words about fear, this resulted in a wealth of short accounts concerning just about anything and everything from dog poo to murder. In this article, I focus on the fears of sexual abuse. This is done because it seems that the ways to write about this kind of fear are quite limited, at least if the accounts focus on fears of sexual abuse in the future. This script is spelled out 'I am afraid that I will be raped by a strange man when I am out on my own, and there will be no one to help me, and I will feel ashamed, although I know I should not'. On the other hand, if the account is about fear originating from something in the past, the script is the opposite. Now the actor is known - it could be a neighbour or a classmate. And the alleged abuse takes place in someone's home, in daylight, in an everyday situation. The borders between these types of accounts and the different contents make it possible to draw the conclusion that they are constructed by and construct different discourses. What it is possible to write about in one's account and 'still be a boy or a girl'? What does this result tell us about what kind of questions are suited to be put to youngsters in surveys that focus on fears of sexual abuse, abstract or concrete ones? My suggested answer is that the more concrete the question, the more possible it is to have accounts that seem to be outside the most narrow discourse on fear of sexual abuse. Maybe it is possible to let this alternative discourse of perpetrators of sexual abuse challenge the main discourse. [PUBLICATION ABSTRACT]",
month =  dec,
year =  2009,
url = "https://search.proquest.com/docview/216206387",
file = "All_Papers/Published_Journal/J_TF1505/Tiby2009_12346.pdf",
keywords = "J\_TF1505",
doi = "10.1080/14043850903326740",
language = "en"
}

