file = "All_Papers/Published_Journal/z_rural2020/Walsh2007_05921.pdf",
keywords = "communities; structural composition; spatially aggregated motor vehicle theft rates; structural correlates; socioeconomic status; stability; age composition; racial heterogeneity; Built Environment; Motor Vehicles; Theft; Age Differences; Social Structure; Urban Environments; Multiculturalism;z\_rural2020;J Crim Justice",
doi = "10.1016/j.jcrimjus.2007.03.006",
language = "en"
}

