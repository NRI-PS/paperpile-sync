language = "en"
}

@ARTICLE{Kelley2018-FinancialStressAndMaritalQualityTheModeratingInfluenceOfCoupleCommunication-..-mr,
title = "Financial stress and marital quality: The moderating influence of couple communication",
author = "Kelley, Heather H and LeBaron, Ashley B and Hill, E Jeffrey",
