file = "All_Papers/30_ReviewE/360_Trust/Higginson2014_16303.pdf",
keywords = "Criminal law; Legitimacy of governments; Crime prevention; Systematic reviews (Medical research); Moderator variables; Crime control; Police legitimacy; Procedural justice; Spatially focused policing; Systematic review;360\_Trust;J Exp Criminol;TPPandPP;police visibility",
doi = "10.1007/s11292-014-9215-6",
language = "en"
}

