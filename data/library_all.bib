@ARTICLE{Rich1995-UsingAutomatedEmergencyNotificationSystemsToInformThePublicAFieldExperiment-..-ff,
title = "Using automated emergency notification systems to inform the public: A field experiment",
author = "Rich, Richard C and Conn, W David",
journal = "Risk analysis: an official publication of the Society for Risk Analysis",
