@ARTICLE{Wu2017-MeasuringTheSpatialAndTemporalPatternsOfPoliceProactivity-..-jo,
title = "Measuring the spatial and temporal patterns of police proactivity",
author = "Wu, Xiaoyun and Lum, Cynthia",
journal = "Journal of quantitative criminology",
