@ARTICLE{Pratt2005-AssessingMacro-levelPredictorsAndTheoriesOfCrimeAMeta-analysis-..-nc,
title = "Assessing macro-level predictors and theories of crime: A meta-analysis",
author = "Pratt, Travis C and Cullen, Francis T",
journal = "Crime and justice",
publisher = "University of Chicago Press",
volume =  32,
pages = "373-450",
abstract = "The macro-level approach reemerged as a salient criminological paradigm in the late 1970s and early 1980s. Prompted by new theories and reformulations of existing ones, over 200 empirical studies explored ecological correlates of crime. Few efforts have been made, however, to make sense of this literature. A meta-analysis was undertaken to determine the relative effects of macro-level predictors of crime. Indicators of concentrated disadvantage (e.g., racial heterogeneity, poverty, and family disruption) are among the strongest and most stable predictors. Except for incarceration, variables indicating increased use of the criminal justice system (e.g., policing and get-tough policy effects) are among the weakest. Across all studies, social disorganization and resource/economic deprivation theories receive strong empirical support; anomie/strain, social support/social altruism, and routine activity theories receive moderate support; and deterrence/rational choice and subcultural theories receive weak support.",
