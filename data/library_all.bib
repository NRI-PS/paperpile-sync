file = "All_Papers/30_ReviewE/360_Trust/Antrobus2015_15605.pdf",
keywords = "360\_Trust",
doi = "10.1177/1043986214568840",
language = "en"
}

@ARTICLE{Asogwa2022-TelevisionAndConflictReportingFramingOfEthno-religiousConflictInSouthernKadunaByNigerianTelevisionAuthorityAndChannelsTelevision-..-ob,
title = "Television and conflict reporting: framing of ethno-religious conflict in Southern Kaduna by Nigerian Television Authority and Channels television",
author = "Asogwa, Chika Euphemia and Okeke, Somtochukwu Victor and Ezeah, Gregory and Gever, Verlumun Celestine",
