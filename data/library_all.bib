file = "All_Papers/30_ReviewE/330_SAEnv/Jones2019_16862.pdf",
keywords = "330\_SAEnv;250109\_multilevel",
doi = "10.1007/s10940-018-9397-6",
language = "en"
}

@ARTICLE{Johnson2015-TestingEcologicalTheoriesOfOffenderSpatialDecisionMakingUsingADiscreteChoiceModel-..-xr,
