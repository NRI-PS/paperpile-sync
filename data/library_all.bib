language = "en"
}

@ARTICLE{Melde2009-TheVictim-offenderOverlapAndFearOfIn-schoolVictimizationALongitudinalExaminationOfRiskAssessmentModels-..-an,
title = "The victim-offender overlap and fear of in-school victimization: A longitudinal examination of risk assessment models",
author = "Melde, Chris and Esbensen, Finn-Aage",
