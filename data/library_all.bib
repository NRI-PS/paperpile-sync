doi = "10.1016/j.jcrimjus.2016.11.002",
language = "en"
}

@ARTICLE{Ferdik2023-CitizenSatisfactionWithThePoliceAndCollege-basedInformalSocialControlsAnUnexpectedFinding-..-zp,
