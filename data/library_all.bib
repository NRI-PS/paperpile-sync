file = "All_Papers/50_Journal_E/Security_Journal/Ratcliffe2010_13579.pdf",
keywords = "Security Journal",
doi = "10.1057/sj.2009.16",
language = "en"
}

@ARTICLE{Robinson2009-AssessingAndManagingRiskAmongDifferentVictimsOfDomesticAbuseLimitsOfAGenericModelOfRiskAssessment-..-hh,
