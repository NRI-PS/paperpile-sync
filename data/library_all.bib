@ARTICLE{Bradford2023-ThinkingHolisticallyAboutProceduralJusticeInAlternativeDisputeResolutionACaseStudyOfTheGermanFederalOmbudsmanScheme-..-pu,
title = "Thinking holistically about procedural justice in alternative dispute resolution: A case study of the German Federal Ombudsman Scheme",
author = "Bradford, Ben and Creutzfeldt, Naomi and Steffek, Felix",
journal = "Law \& social inquiry: journal of the American Bar Foundation",
publisher = "Cambridge University Press (CUP)",
volume =  48,
number =  3,
pages = "748-779",
abstract = "This article examines data collected from users of the German Federal Ombudsman Scheme (GFOS). The data was collected as part of a research project to understand how the GFOS operates in practice and how its procedures and outcomes are accepted by its users. We begin from the premise that experience of procedural justice during this alternative dispute resolution (ADR) process will build institutional legitimacy, and the article makes three contributions to the literature on procedural justice. First, we extend evidence of the link between procedural justice and legitimacy to a novel institutional context that is different in many ways to the criminal justice focus of much of the extant literature. Second, we consider the motivations of service users to engage with ADR as potential moderators of that link. Third, we analyze the relationship between procedural justice, subjective outcomes, and the actual outcomes provided to service users. Overall, we conclude that the link between procedural justice and legitimacy can be identified among those with very different motivations for using the GFOS.",
month =  aug,
year =  2023,
url = "https://www.cambridge.org/core/article/thinking-holistically-about-procedural-justice-in-alternative-dispute-resolution-a-case-study-of-the-german-federal-ombudsman-scheme/96829F12EA4EF8A1B18815E254CE2161",
file = "All_Papers/30_ReviewE/360_Trust/Bradford2022_20395.pdf",
keywords = "360\_Trust",
