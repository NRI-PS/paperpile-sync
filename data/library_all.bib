@ARTICLE{Aizpurua2021-ControllingBehaviorsAndIntimatePartnerViolenceAmongWomenInSpainAnExaminationOfIndividualPartnerAndRelationshipRiskFactorsForPhysicalAndPsychologicalAbuse-..-zj,
