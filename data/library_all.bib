@ARTICLE{Kershaw2005-PredictingCrimeRatesFearAndDisorderBasedOnAreaInformationEvidenceFromThe2000BritishCrimeSurvey-..-rw,
title = "Predicting crime rates, fear and disorder based on area information: Evidence from the 2000 British Crime Survey",
