@ARTICLE{Brabenec2018-CriminalsAndThePriceSystemEvidenceFromCzechMetalThieves-..-mi,
title = "Criminals and the price system: Evidence from Czech metal thieves",
author = "Brabenec, Tomáš and Montag, Josef",
journal = "Journal of quantitative criminology",
publisher = "Springer Science and Business Media LLC",
address = "New York",
volume =  34,
number =  2,
pages = "397-430",
abstract = "Objectives This paper tests the economic theory of criminal behavior. Specifically, it looks at “the carrot” side of the theory, studying how thieves react to changes in monetary gains from crime. Methods Using a unique crime-level dataset on metal theft in the Czech Republic, we study thieves’ behavior in a simple regression framework. We argue that variation in metal prices represents a quasi-experimental variation in gains from crime. It is because (1) people steal copper and other nonferrous metals only to sell them to scrapyard and (2) prices at scrapyards are set by the world market. This facilitates causal interpretation of our regression estimates. Results We find that a 1\% increase (decrease) in the re-sale price causes metal thefts to increase (decrease) by 1–1.5\%. We show that the relationship between prices and thefts is very robust. Moreover, we find that thieves’ responses to price shocks are rapid and consistent. Conclusion Our results are in line with the economic model of crime, wherein criminal behavior is modeled as a rational agent’s decision driven by the costs and benefits of undertaking criminal activities. Our estimates are also consistent with recent results from the United Kingdom, suggesting these patterns are more general.",
month =  jun,
year =  2018,
url = "https://www.jstor.org/stable/48701196",
file = "All_Papers/30_ReviewE/308_STC/Brabenec2018_17272.pdf",
keywords = "Criminology And Law Enforcement; Economics of crime; Rational choice; Gains from crime; Criminal opportunities; Metal theft; Offenders; Theft; Prices; Metals; Crime; Behavior; Benefit cost analysis; Criminality; Economic theory; Czech Republic;308\_STC",
doi = "10.1007/s10940-017-9339-8",
language = "en"
}

@ARTICLE{Burakov2019-OilHikesDrugsAndBribesDoOilPricesMatterForCrimeRateInRussia-..-em,
title = "Oil hikes, drugs and bribes: Do oil prices matter for crime rate in Russia?",
author = "Burakov, D",
journal = "International journal of energy economics and policy",
publisher = "EconJournals",
address = "Mersin",
volume =  9,
number =  1,
pages = "84-94",
abstract = "In this article we test the hypothesis about the impact of oil prices shocks on the unemployment and crime rate on the example of oil-exporting country. According to the hypothesis, there exist a dependence of the labor market on oil revenue. A negative oil price shock should lead to a decrease in the employment rate, which in turn should lead to a rise in illegal forms of behavior. Illegal behavior is measured as an average of registered crimes (bribery and drug dealing). Based on data for 1990-2017 we study a case of Russia, using vector error correction model for detecting short- and long-term effects. Results show that oil prices and unemployment affect crime rate in the long-run in a case of oil-exporting country. Yet, in the short-run both negative oil shocks and a rise in unemployment rate lead to a statistically significant increase in bribery and drug dealing. A 1\% decrease in oil price will lead to a 1,14\% rise in bribery and drug dealing and a 1\% increase in the unemployment rate leads to a 2,72\% increase in drug dealing and bribery.",
