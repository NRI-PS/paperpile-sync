@ARTICLE{Rudolph2020-HowDoesTheWelfareStateReduceCrimeTheEffectOfProgramCharacteristicsAndDecommodificationAcross18OECD-countries-..-tr,
title = "How does the welfare state reduce crime? The effect of program characteristics and decommodification across 18 OECD-countries",
author = "Rudolph, Maximilian and Starke, Peter",
journal = "Journal of criminal justice",
