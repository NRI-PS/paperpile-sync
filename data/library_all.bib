@ARTICLE{Jonathan-Zamir2013-TheEffectsOfSecurityThreatsOnAntecedentsOfPoliceLegitimacyFindingsFromAQuasi-experimentInIsrael-..-zu,
title = "The effects of security threats on antecedents of police legitimacy: Findings from a quasi-experiment in Israel",
