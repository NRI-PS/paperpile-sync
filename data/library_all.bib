year =  2012,
url = "http://dx.doi.org/10.1177/1745691612463704",
file = "All_Papers/Other/Klein2012_10023.pdf",
keywords = "demand characteristics; expectancy; experimenter bias; methodology; replicability",
doi = "10.1177/1745691612463704",
language = "en"
}

