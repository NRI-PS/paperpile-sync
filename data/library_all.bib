@ARTICLE{Brunton-Smith2011-UntanglingTheRelationshipBetweenFearOfCrimeAndPerceptionsOfDisorderEvidenceFromALongitudinalStudyOfYoungPeopleInEnglandAndWales-..-kn,
title = "Untangling the relationship between fear of crime and perceptions of disorder: Evidence from a longitudinal study of young people in England and wales",
author = "Brunton-Smith, I",
journal = "The British journal of criminology",
publisher = "Oxford University Press (OUP)",
volume =  51,
number =  6,
pages = "885-899",
abstract = "Over the last 40 years and more, a growing number of researchers have explored the links between perceptions of disorder and fear of criminal victimization. Many of these studies have posited a causal link from perceptions of disorder to subsequent fear, with disorderly cues in the environment signalling to individuals that an area is in decline and unable to control deviant behaviour. But a growing body of evidence approaches this question from the opposite direction, emphasizing the socially constructed nature of perceived disorder and the potential role that fear may have in giving meaning to ambiguous disorderly cues present in the environment. This conceptual uncertainty stems, in part, from the reliance of existing research on cross-sectional data, making it impossible to say whether it is perceptions of disorder that shape fear or whether fear drives perceived disorder. A cross-lagged panel design is applied to longitudinal data from the Offending Crime and Justice Survey to more carefully explore the causal links between fear and disorder.",
month =  "1~" # nov,
year =  2011,
url = "https://www.jstor.org/stable/23639896",
file = "All_Papers/a_犯罪予防の社会心理学/a_犯罪予防の社会心理学_root/Brunton2011_09123.pdf",
keywords = "a\_犯罪予防の社会心理学\_root;z\_2018\_mera;British Journal of criminology",
doi = "10.1093/bjc/azr064"
}

