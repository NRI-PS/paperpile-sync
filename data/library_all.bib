}

@ARTICLE{Ross2000-NeighborhoodDisorderFearAndMistrustTheBufferingRoleOfSocialTiesWithNeighbors-..-mv,
title = "Neighborhood disorder, fear, and mistrust: the buffering role of social ties with neighbors",
author = "Ross, C E and Jang, S J",
journal = "American journal of community psychology",
