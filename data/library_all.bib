@ARTICLE{Smith2014-ValidationOfTheFactorStructureAndPredictiveValidityOfTheForensicEvidenceEvaluationBiasScaleForRobberyAndSexualAssaultTrialScenarios-..-hr,
title = "Validation of the factor structure and predictive validity of the Forensic Evidence Evaluation Bias Scale for robbery and sexual assault trial scenarios",
