year =  2010,
url = "http://dx.doi.org/10.1080/13669877.2010.488743",
file = "All_Papers/50_Journal_E/J_Risk_Res/Yang2010_13320.pdf;All_Papers/50_Journal_E/J_Risk_Res/Yang2010_13320.pdf",
