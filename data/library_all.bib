@ARTICLE{Korosec-Serfaty1986-DwellingAndTheExperienceOfBurglary-..-bn,
title = "Dwelling and the experience of burglary",
author = "Korosec-Serfaty, Perla and Bolitt, Dominique",
journal = "Journal of environmental psychology",
publisher = "Elsevier BV",
volume =  6,
number =  4,
pages = "329-344",
abstract = "This study attempts to define the fundamental dimensions of the home experience through its dramatization, in this case, when one is burgled. It is based on thirty-six interviews conducted with middle-class urban dwellers who had been burgled a year prior to the interview. The analysis of the data was mainly thematic and hermeneutical. It shows that the dwelling experience is the experience of boundaries, the door being a limit between inside and outside, and also a limit within oneself. Moreover, the uncontrolled access by another person to the hidden/secret subspaces of the dwelling incites reactions which reveal the importance of the dweller's visibility. Lastly, the re-appropriation processes which take place after the burglary show that dwelling is essentially a sum of future-orientated actions.",
