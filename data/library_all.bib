@ARTICLE{Hammond2017-PerceptionsOfMaleRapeAndSexualAssaultInAMaleSampleFromTheUnitedKingdomBarriersToReportingAndTheImpactsOfVictimizationPerceptionsOfMaleRapeAndSexualAssault-..-pq,
