@ARTICLE{Hickman2003-FairTreatmentOrPreferredOutcomeTheImpactOfPoliceBehaviorOnVictimReportsOfDomesticViolenceIncidents-..-gy,
title = "Fair treatment or preferred outcome? The impact of police behavior on victim reports of domestic violence incidents",
