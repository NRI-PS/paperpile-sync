file = "All_Papers/30_ReviewE/312_BW_観察SSO/Franzini2008_05169.pdf;All_Papers/30_ReviewE/312_BW_観察SSO/Franzini2008_05169.pdf;All_Papers/30_ReviewE/312_BW_観察SSO/Franzini2008_05169.pdf",
