@ARTICLE{Connelly2021-ViolentAndNonviolentCrimesAgainstSexWorkersTheInfluenceOfTheSexMarketOnReportingPracticesInTheUnitedKingdom-..-xp,
title = "Violent and nonviolent crimes against sex workers: The influence of the sex market on reporting practices in the United Kingdom",
author = "Connelly, Laura and Kamerāde, Daiga and Sanders, Teela",
journal = "Journal of interpersonal violence",
