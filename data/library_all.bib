number =  1,
pages =  151,
abstract = "Studied the explanatory power of 3 models of fear of crime (FOC) via interviews with 523 Atlanta residents and in crime rate and land use data. The indirect victimization model (IVM) views vulnerable groups that are more likely to be victimized and have more local social ties as related to FOC. The perceived disorder model (PDM) posits that lower socioeconomic status (SES) and a higher incidence of physical and social incivilities heighten perceptions of local problems and elevate FOC. The community concern model (CCM) posits that community conditions lead to perceived problems that lead to community concern, which elevates FOC. Path analyses show that all of the models explain about 10\% of worry. Key social and psychological variables in the IVM and PDM were major predictors of worry. Community concern made no independent contribution to predicting worry. The models varied in predicting FOC, with the CCM predicting best, PDM slightly less well, and IVM least well.",
year =  1986,
url = "http://scholarlycommons.law.northwestern.edu/cgi/viewcontent.cgi?article=6511&context=jclc&sei-redir=1",
file = "All_Papers/30_ReviewE/301_ComCrm/301_3/Taylor1986_00120.pdf;All_Papers/30_ReviewE/301_ComCrm/301_3/Taylor1986_XXXXX.pdf",
keywords = "FEAR of crime; CRIME; FEAR; VICTIMS of crimes; SOCIAL problems;301\_3;z\_2018jssc;犯罪予防の社会心理学\_220\_市川第1波\_2010\_犯社研(4章);z\_2011\_小俣本\_第1章;9\_001\_intro;犯罪予防の社会心理学\_230\_市川第2波3波\_2018\_犯社研(5章);a\_犯罪予防の社会心理学\_root;author\_Taylor;10\_英語の研究;z\_urban\_socio\_root;z\_2009jasc;301\_ComCrm",
doi = "10.2307/1143593"
}

@ARTICLE{Steenbeek2012-LocalBusinessesAsAttractorsOrPreventersOfNeighborhoodDisorder-..-of,
title = "Local businesses as attractors or preventers of neighborhood disorder",
author = "Steenbeek, Wouter and Völker, Beate and Flap, Henk and van Oort, Frank",
journal = "The journal of research in crime and delinquency",
publisher = "SAGE Publications",
address = "Los Angeles, CA",
volume =  49,
number =  2,
pages = "213-248",
abstract = "While businesses may attract potential offenders and thus be conducive to disorder, the number of employees could offset this by exercising social control on offenders. This study uses data from different sources to test this expectation across 278 Dutch neighborhoods in the four largest cities of the Netherlands, using multivariate multilevel analysis to disentangle individual perception differences of disorder and neighborhood effects. Attention is paid to traditional explanations of disorder (i.e., poverty, residential mobility, and ethnic heterogeneity). Results show a positive relationship between business presence and neighborhood disorder. We do not find consistent results of the number of employees (i.e., bigger businesses are not always better or worse). Our research demonstrates that the presence of neighborhood businesses could rival the effects of social disorganization theory.",
month =  may,
year =  2012,
