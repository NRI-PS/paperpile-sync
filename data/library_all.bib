doi = "10.1177/0022427810375578",
language = "en"
}

@ARTICLE{Bellair1997-SocialInteractionAndCommunityCrimeExaminingTheImportanceOfNeighborNetworks-..-gq,
title = "Social interaction and community crime: Examining the importance of neighbor networks",
author = "Bellair, Paul E",
