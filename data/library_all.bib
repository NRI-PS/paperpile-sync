@ARTICLE{Ansari2015-ConvergenceRevisitedAMulti-definitionMulti-methodAnalysisOfTheUCRAndTheNCVSCrimeSeries1973-2008-..-sn,
title = "Convergence revisited: A multi-definition, multi-method analysis of the UCR and the NCVS crime series (1973-2008)",
