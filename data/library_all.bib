language = "en"
}

@ARTICLE{Tita2006-CrimeAndResidentialChoiceANeighborhoodLevelAnalysisOfTheImpactOfCrimeOnHousingPrices-..-ia,
title = "Crime and residential choice: A neighborhood level analysis of the impact of crime on housing prices",
author = "Tita, George E and Petras, Tricia L and Greenbaum, Robert T",
journal = "Journal of quantitative criminology",
