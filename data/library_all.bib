@ARTICLE{Mannell2017-PreventingIntimatePartnerViolenceTowardsAFrameworkForSupportingEffectiveCommunityMobilisationPreventingIntimatePartnerViolence-..-tg,
title = "Preventing Intimate Partner Violence: Towards a Framework for Supporting Effective Community Mobilisation: Preventing intimate partner violence",
