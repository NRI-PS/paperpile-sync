@ARTICLE{Ridgeway2017-EffectOfRailTransitOnCrimeAStudyOfLosAngelesFrom1988To2014-..-ow,
title = "Effect of rail transit on crime: A study of Los Angeles from 1988 to 2014",
author = "Ridgeway, Greg and MacDonald, John M",
journal = "Journal of quantitative criminology",
