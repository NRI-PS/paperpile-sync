year =  2024,
url = "https://doi.org/10.1108/JFC-03-2023-0070",
file = "All_Papers/99_文献なし/Estelami2024_50572.pdf",
keywords = "99\_文献なし;noPDF;tmp",
doi = "10.1108/jfc-03-2023-0070",
language = "en"
}

@ARTICLE{Lichtenberg2019-ProvidingAssistanceForOlderAdultFinancialExploitationVictimsImplicationsForClinicalGerontologists-..-ga,
