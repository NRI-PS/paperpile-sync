booktitle = "2025 IEEE International Conference on Advances in Computing Research On Science Engineering and Technology (ACROSET)",
publisher = "IEEE",
pages = "1-7",
abstract = "Anti-Money Laundering (AML) is a critical component of financial regulation which is aimed at detecting and preventing the illegal transfer and laundering of funds. Traditional AML systems rely heavily on rule-based approaches and often struggle to maintain the sophistication and complexity of modern money laundering techniques. In recent years, machine learning (ML) has emerged as a powerful tool to enhance AML systems by improving accuracy, adaptability, and efficiency. However, a major challenge in training ML models for anti-money laundering and fraud detection domains is extreme class imbalance, where one class which is the number of fraudulent transactions in this case constitute a minuscule proportion of overall financial activities, leading to biased model predictions and poor recall rates. To mitigate this issue, this study implements an ensemble training approach using eXtreme Gradient Boosting (XGBoost), a highly efficient gradient boosting algorithm, in combination with the Synthetic Minority Over-sampling Technique (SMOTE) which underutilized in previous models trained so far on this domain. The integration of SMOTE creating a XGBoost+SMOTE pipeline, thus facilitates synthetic data generation for the minority class, thereby enhancing class representation and enabling the model to generalize more effectively to fraudulent transactions and resulting in improved accuracy, recall and F1-score leading to better detection and low false positives.",
month =  "27~" # sep,
year =  2025,
