file = "All_Papers/30_ReviewE/340_Frauds/Ueno2021_20260.pdf",
keywords = "Japanese version of the Alzheimer's diseases assessment scale-cognitive subscale (ADAS-Jcog); fraud vulnerability; mild cognitive decline; older adult; scams vulnerability;340\_Frauds;jsep2025\_toroma;\_a\_jsep2025\_toroma",
doi = "10.3389/fpsyt.2021.685451",
language = "en"
}

