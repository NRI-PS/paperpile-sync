}

@ARTICLE{Campedelli2020-ExploringTheEffectsOfCOVID-19ContainmentPoliciesOnCrimeAnEmpiricalAnalysisOfTheShort-termAftermathInLosAngeles-..-bl,
title = "Exploring the effects of COVID-19 containment policies on crime: An empirical analysis of the short-term aftermath in Los Angeles",
author = "Campedelli, Gian Maria and Aziani, Alberto and Favarin, Serena",
journal = "arXiv [stat.OT]",
abstract = "This work investigates whether and how COVID-19 containment policies had an immediate impact on crime trends in Los Angeles. The analysis is conducted using Bayesian structural time-series and focuses on nine crime categories and on the overall crime count, daily monitored from January 1st 2017 to March 28th 2020. We concentrate on two post-intervention time windows—from March 4th to March 16th and from March 4\textsuperscript{th} to March 28th 2020—to dynamically assess the short-term effects of mild and strict policies. In Los Angeles, overall crime has significantly decreased, as well as robbery, shoplifting, theft, and battery. No significant effect has been detected for vehicle theft, burglary, assault with a deadly weapon, intimate partner assault, and homicide. Results suggest that, in the first weeks after the interventions are put in place, social distancing impacts more directly on instrumental and less serious crimes. Policy implications are also discussed.",
month =  "23~" # mar,
year =  2020,
url = "https://explore.openaire.eu/search/publication?articleId=od________18::91ede4ee596d855e2e1678244b7bb326",
file = "All_Papers/30_ReviewE/308_STC/Campedelli2020_17656.pdf",
archivePrefix = "arXiv",
primaryClass = "stat.OT",
keywords = "308\_STC",
doi = "10.31219/osf.io/gcpq8"
}

@ARTICLE{Carbone-Lopez2013-SeasonalVariationInViolentVictimizationOpportunityAndTheAnnualRhythmOfTheSchoolCalendar-..-mk,
