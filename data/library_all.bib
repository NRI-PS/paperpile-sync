}

@BOOK{Weisburd2006-CambridgeStudiesInCriminologyPoliceInnovationContrastingPerspectivesContrastingPerspectives-..-am,
title = "Cambridge studies in criminology: Police innovation: Contrasting perspectives: Contrasting Perspectives",
author = "Weisburd, David L and Braga, Anthony A",
editor = "Weisburd, David and Braga, Anthony A",
