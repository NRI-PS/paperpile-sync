@ARTICLE{Larson2019-ExploringTheImpactOf9398DemolitionsOnNeighborhood-levelCrimeInDetroitMichigan-..-bb,
title = "Exploring the impact of 9398 demolitions on neighborhood-level crime in Detroit, Michigan",
author = "Larson, Matthew and Xu, Yanqing and Ouellet, Leah and Klahm, IV, Charles F",
journal = "Journal of criminal justice",
