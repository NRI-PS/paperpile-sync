language = "en"
}

@ARTICLE{Corsaro2012-NotByAccidentAnAnalyticalApproachToTrafficCrashHarmReduction-..-wl,
title = "Not by accident: An analytical approach to traffic crash harm reduction",
author = "Corsaro, Nicholas and Gerard, Daniel W and Engel, Robin S and Eck, John E",
journal = "Journal of criminal justice",
publisher = "Elsevier BV",
volume =  40,
number =  6,
pages = "502-514",
abstract = "This study examines whether a problem-oriented approach used by police in Cincinnati, Ohio called the Crash Analysis Reduction Strategy (CARS) corresponded with a change in the number of traffic crashes that resulted in injuries after implementation onset. Under the CARS model, police developed tactics that focused on targeting high-risk driving behaviors, impaired drivers, and crash hotspot locations within the city.Using a two-phase strategy we first assess local impact by examining injury-related traffic crash patterns at targeted locations. Second, we examine whether traffic crashes that resulted in injuries in Cincinnati significantly diverged relative to similar outcomes across a number of comparison sites.Difference-in-difference negative binomial regression analyses indicates that traffic crashes were significantly lower in Cincinnati – down roughly 5.7\% to 10.3\% in the post-intervention period – when contrasted with comparison sites.Our findings suggest that comprehensive problem solving approaches can significantly reduce the risk of life changing events such as automobile crashes that result in injuries beyond traditional policing efforts that explicitly focus on crime and violence.",
