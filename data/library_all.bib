doi = "10.1080/07418820902763889",
language = "en"
}

@ARTICLE{Hawdon2003-Police-residentInteractionsAndSatisfactionWithPoliceAnEmpiricalTestOfCommunityPolicingAssertions-..-bh,
title = "Police-resident interactions and satisfaction with police: An empirical test of community policing assertions",
author = "Hawdon, James and Ryan, John",
