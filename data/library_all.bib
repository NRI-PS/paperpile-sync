}

@ARTICLE{Reischl2016-AssessingPhysicalDisorderInUrbanNeighborhoodsReliabilityAndValidityOfTheParcelMaintenanceObservationToolAssessingPhysicalDisorderInUrbanNeighborhoods-..-lv,
title = "Assessing physical disorder in urban neighborhoods: Reliability and validity of the parcel maintenance observation tool: Assessing physical disorder in urban neighborhoods",
