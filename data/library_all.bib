}

@ARTICLE{Casteel2023-TabletopScenarioExercisesAsATrainingToolForImprovingResponseToWorkplaceViolence-..-qp,
title = "Tabletop scenario exercises as a training tool for improving response to workplace violence",
author = "Casteel, Carri and Peek-Asa, Corinne and Espinosa, Robyn O and Rugala, Eugene A and Ramirez, Marizen",
journal = "Security journal",
