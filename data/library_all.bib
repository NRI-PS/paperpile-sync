url = "https://www.tandfonline.com/doi/abs/10.1080/15564886.2013.872744",
file = "All_Papers/30_ReviewE/360_Trust/Murphy2014_11705.pdf;All_Papers/30_ReviewE/360_Trust/Murphy2014_11705_質問項目.pdf;All_Papers/30_ReviewE/360_Trust/Murphy2014_11705.pdf",
keywords = "360\_Trust;J\_TF1505;Victims \& Offenders",
doi = "10.1080/15564886.2013.872744",
language = "en"
}

@ARTICLE{Murphy2014-PromotingTrustInPoliceFindingsFromARandomisedExperimentalFieldTrialOfProceduralJusticePolicing-..-hn,
title = "Promoting trust in police: findings from a randomised experimental field trial of procedural justice policing",
author = "Murphy, Kristina and Mazerolle, Lorraine and Bennett, Sarah",
journal = "Policing \& society",
publisher = "Informa UK Limited",
address = "Abingdon",
volume =  24,
number =  4,
pages = "405-424",
abstract = "This paper reports findings from the world's first randomised experimental field trial of procedural justice policing. We tested whether or not procedural justice could be used by police agencies during short, routine traffic stops to increase public trust and confidence in police. Using survey data from 2762 Australian drivers who had been exposed to either a procedural justice script (experimental condition) or a standard police procedure (control condition), it was found that trust and confidence in police was higher in the experimental condition. This was even the case after respondents' demographic background and general perceptions of police were taken into account. Similar effects were not found for drivers' obligation to obey police, nor their willingness to cooperate with police. Importantly, however, trust in police did predict both obligation to obey police and the willingness to cooperate with police. The findings have important implications for procedural justice research and policing practice.",
