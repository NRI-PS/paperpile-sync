keywords = "abused men; counselling; domestic violence; female perpetrators; male victimisation; Help Seeking Behavior; Intimate Partner Violence; Male Attitudes; Perpetrators; Male Female Relations; Victimization;320\_ST実証研究",
doi = "10.1002/capr.12409",
language = "en"
}

