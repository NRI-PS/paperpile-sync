}

@ARTICLE{Mawby2010-PoliceCorporateCommunicationsCrimeReportingAndTheShapingOfPolicingNews-..-ng,
title = "Police corporate communications, crime reporting and the shaping of policing news",
author = "Mawby, Rob C",
journal = "Policing \& society",
