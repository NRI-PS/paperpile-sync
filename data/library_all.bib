@ARTICLE{Amuya2024-MeasuringTheAdoptionOfEnterpriseSecurityRiskManagementInKenyaSHigherEducationUsingTheASISESRMMaturityModel-..-md,
title = "Measuring the adoption of Enterprise Security Risk Management in Kenya’s higher education using the ASIS ESRM Maturity Model",
author = "Amuya, Levis Omusugu and Kariuki, Peterson Mwai",
