}

@ARTICLE{Burrell2009-TacklingViolenceInTheNight-timeEconomyOnTheGroundPuttingPolicyIntoPracticeInEnglandAndWales-..-uu,
title = "Tackling violence in the night-time economy on the ground: Putting policy into practice in England and Wales",
