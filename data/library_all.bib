@ARTICLE{Macmillan1995-ChangesInTheStructureOfLifeCoursesAndTheDeclineOfSocialCapitalInCanadianSocietyATimeSeriesAnalysisOfPropertyCrimeRates-..-up,
title = "Changes in the structure of life courses and the decline of social capital in Canadian society: A time series analysis of property crime rates",
author = "Macmillan, Ross",
journal = "Cahiers canadiens de sociologie [Canadian journal of sociology]",
publisher = "JSTOR",
address = "Edmonton, AB",
volume =  20,
number =  1,
pages =  51,
abstract = "One of the paradoxes of contemporary society is the trend in aggregate crime rates, a trend that, for all intents and purposes, has been consistently upward in the post-war period. Because previous attempts to provide an account of both the motivational and opportunity prerequisites of crime have been relatively weak, the present paper proposes such a framework by integrating insights from life course research with a conception of the age stratification of social control. From this perspective, changes in the timing and order of life course events characteristic of the transition from adolescence to adulthood have weakened social control mechanisms for late teens and young adults. When significant life course events are delayed or removed, there is a consequent decline in institutional bonds and social capital. It is theorized that these declines play an important role in aggregate crime rate trends by increasing the size of the pool of motivated offenders. This perspective was tested in a time series analysis of Canadian property crime data and the results provide strong support for the proposed models. Further implications of this argument are also explored. /// Un des paradoxes de la société contemporaine est la tendance des taux globaux de criminalité. C'est une tendance qui, à toute fin pratique, est demeurée à la hausse de façon constante durant la période d'après-guerre. Les tentatives d'expliquer les facteurs pré-requis du crime, soit la motivation et l'opportunité, se sont avérées relativement faibles; cet article propose une telle structure tout en intégrant des idées provenant de la recherche sur les trajectoires biographiques, à savoir le concept de stratification par couches d'âge du controle social. Dans cette perspective, des altérations du facteur temps et de l'ordre d'événements marquant la transition de l'adolescence à l'âge adulte ont eu pour effet d'affaiblir les mécanismes de contrôle social chez les adolescents plus âgés et les jeunes adultes. Un retard ou une absence d'événements significatifs à cet âge implique le déclin de la solidarité institutionnelle et du capital social. L'article avance que ces déclins ont une influence importante sur les tendances des taux globaux de criminalité en accroissant la population de délinquants motivés. Cette thèse a été mise à l'épreuve dans une série d'analyses diachronizues des données du crime contre la propriété au Canada. Les résultats de ces analyses appuient fortement les modèles proposés. D'autres conséquences de cet argument sont aussi explorées.",
year =  1995,
url = "https://www.jstor.org/stable/3340986",
file = "All_Papers/30_ReviewE/308_STC/Macmillan1995_07589.pdf",
keywords = "CRIME; WAR; SOCIAL control; YOUNG adults; Social Capital; SOCIAL conflict; CANADA;308\_STC",
doi = "10.2307/3340986"
}

