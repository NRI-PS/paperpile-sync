@ARTICLE{Wager2021-ASystematicReviewOfExperimentalStudiesInvestigatingAttitudesTowardsSexualRevictimizationFindingsEcologicalValidityAndScientificRigor-..-ay,
title = "A systematic review of experimental studies investigating attitudes towards sexual revictimization: Findings, ecological validity, and scientific rigor",
author = "Wager, Nadia M and Goodson, Simon and Parton, Loren E",
journal = "Journal of criminal justice",
publisher = "Elsevier BV",
volume =  75,
number =  101832,
pages =  101832,
abstract = "Background Evidence from attrition studies indicates that complainants who experience sexual assault on more than one occasion and by different perpetrators (i.e. sexual revictimization) are unlikely to have their cases progress through to prosecution. Purpose The aim of this systematic review was to ascertain what can be learned from experimental studies to aid the understanding of this real-world phenomenon. Specifically, to investigate the attributions made to hypothetical cases of sexual revictimization in mock-juror-type, (quasi)experimental studies. Methods This systematic review entailed searching 13 electronic databases. Over 6000 potential sources were generated, of which 24 met the criteria for full-text reading. Application of the inclusion criteria, led to this review being based on 12 articles published between 1976 and 2020. These referred to 16 studies involving 4021 participants. Findings The findings, except for one study, revealed consistent evidence of bias towards victims of sexual revictimization, which related to higher levels of disbelief and victim-blame, and other factors. Complainants were blamed most by women when the context was perceived as risky. Conclusions There were several methodological issues with many of the studies which compromised their ecological validity and applicability. Recommendations are made for future research in this area, and police training and practice.",
month =  jul,
year =  2021,
url = "https://www.sciencedirect.com/science/article/pii/S0047235221000520",
file = "All_Papers/30_ReviewE/321_SA実証研究/Wager2021_39320.pdf",
keywords = "Attrition; Sexual revictimization; Attributions; Victim-blame; Believability; Vignettes; Experimental methods; Mock-juror studies;321\_SA実証研究;J Crim Justice",
doi = "10.1016/j.jcrimjus.2021.101832",
language = "en"
}

@ARTICLE{Vakhitova2018-Offender-victimRelationshipAndOffenderMotivationInTheContextOfIndirectCyberAbuseAMixed-methodExploratoryAnalysis-..-mw,
