doi = "10.1080/07418828800089791",
language = "en"
}

@ARTICLE{Vollaard2009-TheEffectOfPoliceOnCrimeDisorderAndVictimPrecautionEvidenceFromADutchVictimizationSurvey-..-ea,
title = "The effect of police on crime, disorder and victim precaution. Evidence from a Dutch victimization survey",
author = "Vollaard, Ben and Koning, Pierre",
