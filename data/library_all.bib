keywords = "COMMUNITY psychology; PSYCHOLOGY, Applied; ENVIRONMENTAL psychology; COMMUNITIES; COMMUNITY relations; NEIGHBORHOOD; RESEARCH; longitudinal analysis; SOCIAL aspects; collective efficacy;301\_3;z\_mera2010;z\_bsj2010;z\_bsj2010\_past;z\_2013\_コミュニティの社会心理学;301\_ComCrm;J Community Psychol",
