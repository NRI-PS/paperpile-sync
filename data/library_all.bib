language = "en"
}

@ARTICLE{Russo2013-CriminalVictimizationAndCrimeRiskPerceptionAMultilevelLongitudinalStudy-..-aa,
title = "Criminal victimization and crime risk perception: A multilevel longitudinal study",
author = "Russo, Silvia and Roccato, Michele and Vieno, Alessio",
journal = "Social indicators research",
