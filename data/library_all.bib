language = "en"
}

@ARTICLE{Lipkus2006-EffectsOfCommunicatingSocialComparisonInformationOnRiskPerceptionsForColorectalCancer-..-bo,
title = "Effects of communicating social comparison information on risk perceptions for colorectal cancer",
author = "Lipkus, Isaac M and Klein, William M P",
journal = "Journal of health communication",
