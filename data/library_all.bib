@ARTICLE{Griffin2004-TeachingCognitiveRehearsalAsAShieldForLateralViolenceAnInterventionForNewlyLicensedNurses-..-lc,
title = "Teaching cognitive rehearsal as a shield for lateral violence: an intervention for newly licensed nurses",
author = "Griffin, Martha",
