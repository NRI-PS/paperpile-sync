@ARTICLE{Senese1989-CrimeInHighAndLowCrimeNeighborhoodsAnAssessmentOfSocialAndPhysicalDimensions-..-oi,
title = "Crime in high and low crime neighborhoods: An assessment of social and physical dimensions",
author = "Senese, Jeffrey D",
journal = "Journal of crime and justice",
