keywords = "attitudes toward police; racial differences; Blacks; Whites; television news watching; reality TV programs; News Media; Police Personnel; Racial and Ethnic Attitudes; Racial and Ethnic Differences; Television Viewing;360\_Trust;J Crim Justice",
doi = "10.1016/s0047-2352(02)00133-2",
language = "en"
}

@ARTICLE{Dukes2009-ModelsOfSatisfactionWithPoliceService-..-yb,
