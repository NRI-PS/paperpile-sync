@ARTICLE{Porter2012-SocialDisorganizationAndNeighborhoodFearExaminingTheIntersectionOfIndividualCommunityAndCountyCharacteristics-..-er,
title = "Social disorganization and neighborhood fear: Examining the intersection of individual, community, and county characteristics",
author = "Porter, Jeremy R and Rader, Nicole E and Cossman, Jeralynn S",
journal = "American journal of criminal justice: AJCJ",
