title = "Council-based approaches to intimate partner violence: evidence for distal change in the system response",
author = "Allen, Nicole E and Todd, Nathan R and Anderson, Carolyn J and Davis, Shara M and Javdani, Shabnam and Bruehler, Vernie and Dorsey, Heather",
