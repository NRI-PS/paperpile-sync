keywords = "320\_ST実証研究;Journal of Research in Crime and Delinquency\_Sage",
doi = "10.1177/0022427816656897",
language = "en"
}

@ARTICLE{Bookwala1992-PredictorsOfDatingViolenceAMultivariateAnalysis-..-vi,
