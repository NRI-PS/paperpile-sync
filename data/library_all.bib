language = "en"
}

@ARTICLE{Meffert2014-ProspectiveStudyOfPoliceOfficerSpouse/partnersANewPathwayToSecondaryTraumaAndRelationshipViolence-..-rh,
title = "Prospective study of police officer spouse/partners: a new pathway to secondary trauma and relationship violence?",
