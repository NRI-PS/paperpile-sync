keywords = "public worry; safety; burglary; crime; criminal justice; victimization likelihood; Public Opinion; Theft; Crime Victims; Criminal Behavior; Victimization; British Crime Survey;301\_ComCrm;police visibility",
doi = "10.1007/s11205-006-6011-3",
language = "en"
}

@ARTICLE{Treno2008-ExaminingMulti-levelRelationshipsBetweenBarsHostilityAndAggressionSocialSelectionAndSocialInfluence-..-qn,
title = "Examining multi-level relationships between bars, hostility and aggression: social selection and social influence",
author = "Treno, Andrew J and Gruenewald, Paul J and Remer, Lillian G and Johnson, Fred and Lascala, Elizabeth A",
journal = "Addiction (Abingdon, England)",
