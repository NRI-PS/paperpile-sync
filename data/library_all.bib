language = "en"
}

@ARTICLE{Kaminski2010-TheImpactsOfTheVirginiaTechAndNorthernIllinoisUniversityShootingsOnFearOfCrimeOnCampus-..-uc,
title = "The impacts of the Virginia Tech and Northern Illinois University shootings on fear of crime on campus",
author = "Kaminski, Robert J and Koons-Witt, Barbara A and Thompson, Norma Stewart and Weiss, Douglas",
journal = "Journal of criminal justice",
publisher = "Elsevier BV",
volume =  38,
number =  1,
pages = "88-98",
abstract = "There has been a substantial increase in the number of mass shooting incidents on college campuses in the United States in recent years. Although empirical research examined the impacts of secondary school shootings on student fear, there have been no comparable studies of the impacts of campus shootings. This study began to fill this void by examining responses to surveys administered to convenience samples of students enrolled at the University of South Carolina prior to and following the mass shooting incidents on the campuses of Virginia Tech and Northern Illinois University. Findings indicated that both shootings were associated with modest increases in various measures of fear. Other findings were that the impacts of the shootings depended on both the type of fear measured (e.g., general fear versus fear of being a victim of specific crimes) and student characteristics such as age, sex, and race.",
