@ARTICLE{Fagan1987-CrimeAtHomeAndInTheStreetsTheRelationshipBetweenFamilyAndStrangerViolence-..-ln,
title = "Crime at home and in the streets: the relationship between family and stranger violence",
author = "Fagan, J and Wexler, S",
journal = "Violence and victims",
publisher = "Springer Publishing Company",
