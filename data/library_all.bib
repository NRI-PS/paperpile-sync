journal = "Violence and victims",
publisher = "Springer Publishing Company",
address = "United States",
volume =  17,
number =  5,
pages = "541-553",
abstract = "Research indicates that stalking is an extension of intimate partner violence. The overall purpose of this study was to better understand stalkers by examining the association between a protective order history and the court's processing of subsequent stalking, and to examine patterns of reoffending. This study examined a sample of 346 males who were charged with stalking in 1999 in one state. Subjects were partitioned into three groups: (1) males without protective orders; (2) males with one prior protective order; and (3) males with two or more prior protective orders. Almost two-thirds of the stalkers had a protective order against them at some point in the study, suggesting that stalking is associated with intimate partner violence. Results also found a linear trend with many of the criminal justice involvement variables and protective order history prior to 1999. Those charged with first-degree stalking were more likely to be found guilty initially, and about one-third of all three study groups had the initial felony stalking charge amended. Of those charged with second-degree stalking, only 7\% of the group with two or more protective orders was initially found guilty, which was substantially less than the other two groups. And, when all the amendment dispositions were considered, there were no significant differences by group in guilty and dismissed dispositions for the index stalking charge. Further, consistent with previous criminal justice involvement, the group with two or more protective orders was more likely to have subsequent felony charges than the other two groups. Implications are discussed.",
month =  oct,
year =  2002,
url = "https://dx.doi.org/10.1891/vivi.17.5.541.33713",
file = "All_Papers/30_ReviewE/320_ST実証研究/Logan2002_11131.pdf",
