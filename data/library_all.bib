file = "All_Papers/30_ReviewE/370_Isolation/Bullock2020_19108.pdf",
keywords = "intersectional analysis; feminization; homelessness; mothers; housing; Feminism; Homeless; Safety; Sex Roles; Economics; Intimate Partner Violence; Policy Making; Shock; Oppression;370\_Isolation",
doi = "10.1111/josi.12406",
language = "en"
}

@ARTICLE{Bozdag2021-ThePsychologicalEffectsOfStayingHomeDueToTheCOVID-19Pandemic-..-um,
