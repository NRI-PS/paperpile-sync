@INCOLLECTION{McGuire2021-WhatWorksInPublicAwarenessCampaignsAScopingReview-..-un,
title = "What works in public awareness campaigns? A scoping review",
author = "McGuire, James and Evans, Emily and Kane, Eddie",
editor = "McGuire, James and Evans, Emily and Kane, Eddie",
booktitle = "Evidence-Based Policing and Community Crime Prevention",
publisher = "Springer International Publishing",
address = "Cham",
pages = "417-433",
abstract = "How effective are public awareness campaigns focused on criminal justice? The objective of the review was to locate and briefly summarize the range of empirical studies relevant to this question but not to extract detailed information and identify effective methods, but simply to outline the range of work in the field. Seven electronic databases were searched and the contents tables of four journals inspected, identifying a set of 551 potentially relevant records. After screening, 52 items were retained for fuller analysis. The retained studies and reports were divided into three categories: (1) general crime prevention materials and research studies, (2) a smaller group of reports describing responses to specific crime prevention initiatives or exercises and (3) research reports focused on prevention of specific types of offences. There is evidence that public awareness campaigns work better when they are aligned with changes in the law and accompanied by effective enforcement. Campaigns are more likely to be effective when a range of methods is used to ensure publicity. The relationship between policing and criminal justice awareness campaigns has been compared with analogous work in the field of public health, and the relation between the two is briefly discussed.",
year =  2021,
url = "https://doi.org/10.1007/978-3-030-76363-3_11",
keywords = "363\_publicity;PDFなし",
doi = "10.1007/978-3-030-76363-3\_11"
}

