url = "https://www.sciencedirect.com/science/article/pii/S0047235210000371",
file = "All_Papers/50_Journal_E/J_Crim_Justice/1-s2.0-S0047235210000371-main.pdf",
keywords = "J Crim Justice;356\_ProcessEval",
