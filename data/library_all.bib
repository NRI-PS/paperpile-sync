@ARTICLE{Bradley2016-LeavingPrisonAMultilevelInvestigationOfRacialEthnicAndGenderDisproportionalityInCorrectionalRelease-..-wh,
title = "Leaving prison: A multilevel investigation of racial, ethnic, and gender disproportionality in correctional release",
