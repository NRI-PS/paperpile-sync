keywords = "VIOLENT crimes; CRIME; SOCIAL disorganization; CRIMINAL justice, Administration of; TIME-series analysis; JAPAN; crime trend; pooled time-series analysis;308\_STC;社会経済・空間変数と犯罪;criminology;old;\_\_\_202403\_自動車盗論文;Japan",
doi = "10.1111/j.1745-9125.2004.tb00517.x",
