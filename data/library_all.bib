file = "All_Papers/30_ReviewE/302_CogBias/Avis1989_06705.pdf",
keywords = "HEALTH risk assessment; DISEASES; MEDICINE, Preventive; PUBLIC health; MYOCARDIAL infarction; RISK factors; RISK perception; CORONARY heart disease; BLOOD pressure; CHOLESTEROL;302\_CogBias",
