@ARTICLE{Li2022-Work-familyConflictsStressAndTurnoverIntentionAmongHongKongPoliceOfficersAmidTheCOVID-19Pandemic-..-og,
title = "Work-family conflicts, stress, and turnover intention among Hong Kong police officers amid the COVID-19 pandemic",
