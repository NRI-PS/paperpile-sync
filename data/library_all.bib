doi = "10.1080/19361610903407814",
language = "en"
}

@ARTICLE{Jackson2007-EnsuringEfficiencyInteragencyCooperationAndProtectionOfCivilLibertiesShiftingFromATraditionalModelOfPolicingToAnIntelligence-ledPolicingILPParadigm-..-ex,
