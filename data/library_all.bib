file = "All_Papers/30_ReviewE/320_ST実証研究/Paniagua2017_19928.pdf",
keywords = "risk of partner violence; missing data; item response theory; Severe Intimate Partner Violence Risk Prediction Scale-Revised; Humans; Intimate Partner Violence; Male; Models, Statistical; Risk Assessment; Self Report; Risk Factors; Prediction; Test Forms;320\_ST実証研究",
doi = "10.7334/psicothema2016.75",
language = "en"
}

