year =  2021,
url = "https://doi.org/10.1007/s11524-020-00475-1",
file = "All_Papers/30_ReviewE/320_ST実証研究/s11524-020-00475-1.pdf",
keywords = "Community violence; Intimate partner violence; Neighborhood; Social capital;320\_ST実証研究",
doi = "10.1007/s11524-020-00475-1",
language = "en"
}

